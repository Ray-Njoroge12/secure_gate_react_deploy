{
  "enabled": true,
  "name": "Auto Translation Generator",
  "description": "Monitors changes to localization files (.json, .yaml, .yml) and automatically generates translations for all configured target languages when new or modified text content is detected",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.json",
      "**/*.yaml",
      "**/*.yml",
      "**/locales/**/*",
      "**/i18n/**/*",
      "**/translations/**/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A localization file has been modified. Please:\n\n1. Analyze the changed file to identify new or modified text content that needs translation\n2. Determine the source language and extract translatable strings\n3. Identify all target languages configured in the project (look for existing locale files like en.json, sw.json, fr.json, etc.)\n4. Generate accurate translations for each target language, ensuring:\n   - Proper context and meaning preservation\n   - Adherence to locale-specific conventions\n   - Consistency with existing translations\n   - Appropriate handling of placeholders, variables, and formatting\n5. Update or create the corresponding translation files for each target language\n6. Validate that all translation files maintain the same structure and keys\n7. Provide a summary of what was translated and which files were updated\n\nFocus on maintaining translation quality and consistency across all supported languages while preserving the original meaning and context."
  }
}
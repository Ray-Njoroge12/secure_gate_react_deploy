{
  "enabled": true,
  "name": "Code Quality Analyzer",
  "description": "Automatically analyzes modified source code files for potential improvements, code smells, design patterns, and best practices. Provides actionable suggestions for enhancing code quality, readability, maintainability, and performance while preserving existing functionality.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.js",
      "*.jsx",
      "*.ts",
      "*.tsx",
      "*.py",
      "*.java",
      "*.cpp",
      "*.c",
      "*.cs",
      "*.php",
      "*.rb",
      "*.go",
      "*.rs",
      "*.swift",
      "*.kt",
      "*.scala",
      "*.sql"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Analyze the recently modified code file for potential improvements. Focus on:\n\n1. **Code Smells & Anti-patterns**: Identify any code smells, anti-patterns, or violations of SOLID principles\n2. **Design Patterns**: Suggest appropriate design patterns that could improve the code structure\n3. **Best Practices**: Check adherence to language-specific best practices and coding standards\n4. **Performance**: Identify potential performance bottlenecks and optimization opportunities\n5. **Readability**: Suggest improvements for code clarity, naming conventions, and documentation\n6. **Maintainability**: Recommend changes that would make the code easier to maintain and extend\n7. **Security**: Flag any potential security vulnerabilities or concerns\n8. **Testing**: Suggest areas where additional testing might be beneficial\n\nProvide specific, actionable suggestions with code examples where appropriate. Prioritize improvements that offer the most value while maintaining the existing functionality. Consider the project's technology stack and architectural patterns when making recommendations."
  }
}
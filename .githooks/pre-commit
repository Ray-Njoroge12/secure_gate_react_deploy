#!/usr/bin/env bash
set -euo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "${staged_files}" ]]; then
  exit 0
fi

blocked_files=()
while IFS= read -r file; do
  [[ -z "${file}" ]] && continue
  case "${file}" in
    *playwright-report/*|playwright-report/*|*test-results/*|test-results/*|*playwright-results*.json)
      blocked_files+=("${file}")
      ;;
  esac
done <<< "${staged_files}"

if (( ${#blocked_files[@]} > 0 )); then
  echo ""
  echo "ERROR: Generated Playwright artifacts are staged."
  echo "Please unstage/remove these files before committing:"
  for file in "${blocked_files[@]}"; do
    echo "  - ${file}"
  done
  echo ""
  echo "Suggested fix:"
  echo "  git restore --staged <path>"
  echo ""
  exit 1
fi

exit 0

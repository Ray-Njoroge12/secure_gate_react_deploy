# ==============================================================================
# SECURE GATE ACCESS - STAGING ENV TEMPLATE
# ==============================================================================
# Copy to .env.staging for local staging-like validation only.
# Do NOT commit .env.staging with real secrets.
# ==============================================================================

NODE_ENV=staging
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/secure_gate_staging
PGSSLMODE=require

# Core secrets (replace before use)
JWT_SECRET=replace-me-staging-jwt-secret
JWT_REFRESH_SECRET=replace-me-staging-refresh-secret
SESSION_SECRET=replace-me-staging-session-secret
ENCRYPTION_KEY=replace-me-staging-encryption-key-64-hex

# App endpoints
CLIENT_ORIGIN=https://staging.secure-gate.example
REACT_APP_API_URL=https://staging-api.secure-gate.example
REACT_APP_WS_URL=wss://staging-api.secure-gate.example

# AWS Secrets Manager integration
USE_AWS_SECRETS=true
AWS_REGION=us-east-1
SECRETS_PREFIX=secure-gate/staging

# Security defaults
SECURE_COOKIES=true
TRUST_PROXY=true
ENFORCE_HTTPS=true
DISABLE_CSRF=false
ENABLE_RATE_LIMIT=true

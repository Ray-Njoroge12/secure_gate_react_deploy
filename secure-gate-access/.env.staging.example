# SecureGate Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV=staging

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5001

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Option 1: Connection string (preferred for cloud providers)
DATABASE_URL=postgresql://user:password@host:5432/secure_gate_staging?sslmode=require

# Option 2: Individual variables
# PGHOST=your-db-host.render.com
# PGPORT=5432
# PGUSER=your_db_user
# PGPASSWORD=your_secure_password
# PGDATABASE=secure_gate_staging

# Pool configuration
PGPOOL_MAX=10
PGPOOL_MIN=2
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=30000

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# IMPORTANT: Generate unique secrets for each environment!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=your-staging-jwt-secret-min-32-characters-required
JWT_REFRESH_SECRET=your-staging-refresh-secret-min-32-characters
SESSION_SECRET=your-staging-session-secret-min-32-characters

# Token expiration
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_FROM=noreply@staging.securegate.app
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
REACT_APP_API_URL=https://api-staging.securegate.app/api
REACT_APP_WS_URL=wss://api-staging.securegate.app/ws

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn-for-staging

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_WEBSOCKETS=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGIN=https://staging.securegate.app,http://localhost:3000

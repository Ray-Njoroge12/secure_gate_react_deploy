{
  "dashboard": {
    "id": null,
    "title": "Secure Gate High Availability Dashboard",
    "tags": ["secure-gate", "ha", "monitoring"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"secure-gate-backend\"}",
            "legendFormat": "Backend Status"
          },
          {
            "expr": "up{job=\"postgres-exporter\"}",
            "legendFormat": "PostgreSQL Status"
          },
          {
            "expr": "up{job=\"redis-exporter\"}",
            "legendFormat": "Redis Status"
          },
          {
            "expr": "up{job=\"vault\"}",
            "legendFormat": "Vault Status"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "PostgreSQL Cluster Status",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_replication_lag",
            "legendFormat": "Replication Lag (bytes)"
          },
          {
            "expr": "pg_stat_database_numbackends",
            "legendFormat": "Active Connections"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 3,
        "title": "Redis Cluster Status",
        "type": "graph",
        "targets": [
          {
            "expr": "redis_memory_used_bytes",
            "legendFormat": "Memory Used"
          },
          {
            "expr": "redis_connected_clients",
            "legendFormat": "Connected Clients"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Vault Cluster Status",
        "type": "graph",
        "targets": [
          {
            "expr": "vault_sealed",
            "legendFormat": "Sealed Status"
          },
          {
            "expr": "vault_leader_election_duration_seconds",
            "legendFormat": "Leader Election Duration"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 5,
        "title": "Load Balancer Status",
        "type": "graph",
        "targets": [
          {
            "expr": "haproxy_current_connections",
            "legendFormat": "Active Connections"
          },
          {
            "expr": "haproxy_backend_response_time_seconds",
            "legendFormat": "Response Time"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      },
      {
        "id": 6,
        "title": "SLO Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "secure_gate_availability_percent",
            "legendFormat": "Availability %"
          },
          {
            "expr": "secure_gate_rto_seconds",
            "legendFormat": "RTO (seconds)"
          },
          {
            "expr": "secure_gate_rpo_seconds",
            "legendFormat": "RPO (seconds)"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}

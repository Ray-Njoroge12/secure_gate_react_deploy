# Secure Gate Access Control System
# Production Environment Configuration Template
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/secure_gate
# Or use individual variables:
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=secure_gate
# PG_USER=your_user
# PG_PASSWORD=your_password

# ===========================================
# SERVER
# ===========================================
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
TRUST_PROXY=true

# ===========================================
# SECURITY - JWT
# ===========================================
# IMPORTANT: Generate strong secrets (64+ characters)
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-long-for-security
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-64-characters-long
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ===========================================
# REDIS CACHE
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL=300

# ===========================================
# EMAIL - MAILGUN
# ===========================================
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=Secure Gate

# ===========================================
# SMS - AFRICA'S TALKING
# ===========================================
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=your-username
AFRICASTALKING_SENDER_ID=SecureGate

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ===========================================
# SECURITY HEADERS
# ===========================================
ENFORCE_HTTPS=true
SECURE_COOKIES=true
HSTS_MAX_AGE=31536000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
LOG_FILE=logs/production.log

# ===========================================
# MONITORING
# ===========================================
ENABLE_MONITORING=true
HEALTH_CHECK_INTERVAL=30000

# ===========================================
# MFA (Multi-Factor Authentication)
# ===========================================
MFA_ENABLED=true
MFA_ISSUER=SecureGate

# ===========================================
# SESSION
# ===========================================
SESSION_SECRET=your-session-secret-minimum-64-characters
SESSION_MAX_AGE=86400000

# ===========================================
# FILE UPLOAD
# ===========================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# ===========================================
# ERROR MONITORING - SENTRY (Phase 4.3)
# ===========================================
# Get DSN from https://sentry.io/settings/your-org/projects/secure-gate-server/keys/
SENTRY_DSN=https://your-server-dsn@sentry.io/12345678
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=secure-gate@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ===========================================
# OPTIONAL: OTHER EXTERNAL SERVICES
# ===========================================
# GOOGLE_ANALYTICS_ID=your-ga-id

# ===========================================
# WHATSAPP BUSINESS API
# ===========================================
# Get these from Meta Business Suite > WhatsApp Manager
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Template names (must be pre-approved in WhatsApp Business Manager)
WHATSAPP_TEMPLATE_VISITOR_PASS=visitor_pass_notification
WHATSAPP_TEMPLATE_APPROVAL_REQUEST=approval_request
WHATSAPP_TEMPLATE_CHECK_IN=check_in_notification

# =============================================================================
# Secure Gate Access Control System - Server Environment Template
# =============================================================================
# Copy this file to .env and fill in your values
# For production, set environment variables via hosting dashboard (Render, etc.)
# =============================================================================

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/secure_gate
# Or use individual variables:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=secure_gate
# PGUSER=your_user
# PGPASSWORD=your_password

# Pool settings
# PGPOOL_MAX=10
# PGPOOL_MIN=2
# PGPOOL_IDLE_TIMEOUT=30000

# ===========================================
# SERVER
# ===========================================
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
# ADDITIONAL_ORIGINS=https://admin.yourdomain.com
# TRUST_PROXY=true

# ===========================================
# SECURITY - JWT
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-long-for-security
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-64-characters-long

# ===========================================
# SECURITY - ENCRYPTION
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key-for-aes-256-encryption
# ENCRYPTION_METHOD=local

# ===========================================
# SECURITY - SESSION
# ===========================================
SESSION_SECRET=your-session-secret-minimum-64-characters

# ===========================================
# SECURITY - OTP
# ===========================================
OTP_DEBUG_ECHO=false

# ===========================================
# SECURITY - HEADERS (production)
# ===========================================
# ENFORCE_HTTPS=true
# SECURE_COOKIES=true
# HSTS_MAX_AGE=31536000

# ===========================================
# EMAIL - MAILGUN
# ===========================================
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# EMAIL - SMTP (alternative to Mailgun)
# ===========================================
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-smtp-app-password
# SMTP_SECURE=false
# EMAIL_FROM=noreply@yourdomain.com

# ===========================================
# SMS - AFRICA'S TALKING
# ===========================================
# AFRICASTALKING_API_KEY=your-africastalking-api-key
# AFRICASTALKING_USERNAME=your-username

# ===========================================
# SMS - TWILIO (alternative)
# ===========================================
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# WHATSAPP BUSINESS API
# ===========================================
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
# WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
# WHATSAPP_APP_SECRET=your-app-secret
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ===========================================
# REDIS (optional - for caching)
# ===========================================
# REDIS_URL=redis://user:password@your-redis-host:6379
# CACHE_ENABLED=true

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# RATE LIMITING
# ===========================================
# RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=5

# ===========================================
# MFA
# ===========================================
# MFA_ISSUER=SecureGate

# ===========================================
# ANPR (optional)
# ===========================================
# ENABLE_ANPR_INTEGRATION=false

# ===========================================
# ERROR MONITORING - SENTRY (optional)
# ===========================================
# SENTRY_DSN=https://your-dsn@sentry.io/12345678
# SENTRY_ENVIRONMENT=production

# ===========================================
# CENTRALIZED LOGGING (optional - Grafana Loki)
# ===========================================
# LOGGING_CENTRALIZATION_ENABLED=false
# LOGGING_ENDPOINT=http://your-loki-host:3100

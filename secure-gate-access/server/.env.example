# =============================================================================
# Secure Gate Access Control — Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Server ---
PORT=3001
NODE_ENV=development           # development | production | test
LOG_LEVEL=info                 # error | warn | info | debug

# --- Database ---
# Use DATABASE_URL OR individual PG* vars (not both)
DATABASE_URL=postgresql://user:password@localhost:5432/secure_gate
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=secure_gate
# PGUSER=
# PGPASSWORD=
PGSSLMODE=require              # disable (local dev) | require (prod)

# --- Auth & Secrets (generate with: openssl rand -base64 64) ---
JWT_SECRET=secure-gate-dev-jwt-secret-change-before-production-32chars-min
JWT_REFRESH_SECRET=secure-gate-dev-refresh-secret-change-before-production-32chars
SESSION_SECRET=secure-gate-dev-session-secret-change-before-production-32chars
ENCRYPTION_KEY=

# Optional in development/test only: suppress weak-secret warnings if using local placeholders
DEV_SUPPRESS_WEAK_SECRET_WARNINGS=false

# Token expiry (optional, defaults to 15m / 30d)
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
CLIENT_ORIGIN=http://localhost:3000   # e.g. https://app.yoursite.com
# CORS_ORIGIN=                         # legacy alias for CLIENT_ORIGIN (avoid in new configs)

# --- Email (choose one provider) ---
EMAIL_PROVIDER=smtp             # smtp | mailgun | ses
EMAIL_FROM=noreply@yoursite.com

# SMTP / MailHog (local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_AUTH=false
# SMTP_USER=
# SMTP_PASS=

# Mailgun (production)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.yoursite.com

# --- MFA (TOTP) ---
MFA_ISSUER=Secure Gate Access Control
MFA_ENCRYPTION_KEY=            # separate 64-char key for MFA backup codes

# --- Push Notifications (Web Push / VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yoursite.com

# --- SMS (Africa's Talking) ---
ENABLE_EXTERNAL_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_FROM=SECUREGATE
# Legacy alias support (optional):
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_FROM=SECUREGATE

# --- Redis (optional — for sessions & caching) ---
# REDIS_URL=redis://localhost:6379

# --- Backup/Restore tooling (strict native mode) ---
# Native PostgreSQL client binaries are required for backup/restore operations.
# Docker fallback is intentionally disabled/unsupported.
# Optional overrides if binaries are not on PATH:
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_BASEBACKUP_PATH=/usr/bin/pg_basebackup
# PSQL_PATH=/usr/bin/psql
# PG_RESTORE_PATH=/usr/bin/pg_restore
# TAR_PATH=/usr/bin/tar

# --- AWS (production only) ---
# USE_AWS_SECRETS=true
# AWS_REGION=us-east-1
# SECRETS_PREFIX=secure-gate/production

# --- Security flags (dev overrides) ---
# Accepted boolean values: true/false, 1/0, yes/no, on/off
# DISABLE_CSRF=true             # dev only — never set true in production
# ENABLE_RATE_LIMIT=false       # set true in production
# DEBUG_AUTH=false
# ENFORCE_HTTPS=true             # required in production unless temporary override is needed
# ALLOW_HTTP_IN_PRODUCTION=false # emergency override only
# SECURE_COOKIES=true            # required in production/staging

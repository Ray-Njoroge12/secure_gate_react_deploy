## Environment Configuration for Secure Gate
# Copy to .env and replace all placeholder values with secure, random secrets.
# 
# ⚠️  SECURITY NOTICE: Never commit .env files to version control!
# 🔐 Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ==========================================
# Application Environment
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
PGUSER=postgres
PGPASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
PGHOST=localhost
PGPORT=5432
PGDATABASE=secure_gate

# Database Connection Pool (Performance Tuning)
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=5000

# ==========================================
# JWT Authentication & Security Secrets
# ==========================================
# CRITICAL: Replace with cryptographically secure 64+ character secrets
# Use: node -e "console.log('SECRET=' + require('crypto').randomBytes(64).toString('base64url'))"

JWT_SECRET=REPLACE_WITH_64_BYTE_CRYPTOGRAPHIC_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_CRYPTOGRAPHIC_SECRET
SESSION_SECRET=REPLACE_WITH_64_BYTE_CRYPTOGRAPHIC_SECRET

# JWT Token Expiration (minutes)
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=10080

# ==========================================
# Security & Transport Configuration
# ==========================================
# Production settings - set to 'true' for production deployment
ENFORCE_HTTPS=true
SECURE_COOKIES=true  
TRUST_PROXY=true

# Transport Layer Security
HSTS_MAX_AGE=63072000
ENABLE_HPKP=false
HPKP_PINS=
HPKP_MAX_AGE=300

# CORS Configuration
CLIENT_ORIGIN=http://localhost:3000
ADDITIONAL_ORIGINS=

# ==========================================
# Rate Limiting Configuration
# ==========================================
# General API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication rate limiting (more restrictive)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# OTP rate limiting (very restrictive)
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3

# ==========================================
# Redis Configuration (Optional - for rate limiting)
# ==========================================
# If not set, will use in-memory rate limiting
REDIS_URL=

# ==========================================
# Email/SMS Configuration
# ==========================================
# Email Provider Selection: 'mailgun' or 'smtp'
EMAIL_PROVIDER=mailgun

# Mailgun Configuration (Recommended)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org
MAILGUN_BASE_URL=https://api.mailgun.net
EMAIL_FROM=noreply@your-mailgun-domain.mailgun.org

# SMTP Email Configuration (Fallback/Alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Secure Gate

# SMS Provider Selection: 'africastalking' or 'twilio'
SMS_PROVIDER=africastalking

# Africa's Talking Configuration (Recommended for Kenya/Africa)
AT_USERNAME=your-africastalking-username
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=

# Twilio SMS Configuration (Alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==========================================
# Data Encryption Configuration
# ==========================================
# Encryption Method: 'aws-kms', 'vault', or 'local' (development only)
ENCRYPTION_METHOD=aws-kms

# AWS KMS Configuration (Recommended for AWS deployment)
AWS_KMS_KEY_ID=your-kms-key-id
AWS_REGION=af-south-1

# HashiCorp Vault Configuration (Alternative for Docker/HA)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_ENCRYPTION_KEY_PATH=secret/data/encryption-keys

# Local Encryption Key (DEVELOPMENT ONLY - NOT FOR PRODUCTION)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ==========================================
# Site Configuration
# ==========================================
SITE_NAME=Secure Gate Access
SITE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ==========================================
# Feature Flags & Development Settings
# ==========================================
# OTP Configuration
OTP_DEBUG_ECHO=false
OTP_TTL_MINUTES=15
ALERT_ON_OTP_FAILS=false

# Cron Job Configuration
CRON_INVITE_LIFECYCLE=0 * * * *
CRON_VISITOR_EXPIRE=0 2 * * *

# ==========================================
# Security Hardening Notes
# ==========================================
# 
# 🔐 SECRET GENERATION:
#    Use: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
#    Or:  openssl rand -base64 64
# 
# 🚨 PRODUCTION CHECKLIST:
#    □ Replace ALL placeholder secrets with strong random values
#    □ Set NODE_ENV=production
#    □ Set ENFORCE_HTTPS=true  
#    □ Set SECURE_COOKIES=true
#    □ Set TRUST_PROXY=true (if behind reverse proxy)
#    □ Set OTP_DEBUG_ECHO=false
#    □ Configure proper CLIENT_ORIGIN for CORS
#    □ Set up Redis for production rate limiting
#    □ Configure Mailgun API key and domain
#    □ Configure Africa's Talking username and API key
#    □ Set up AWS KMS key for data encryption
#    □ Configure SITE_URL and FRONTEND_URL for production
#    □ Add authorized email recipients in Mailgun sandbox (if using sandbox)
#    □ Add SMS credits to Africa's Talking account
# 
# ⚠️  MAILGUN SANDBOX LIMITATIONS:
#    - Sandbox domains can only send to authorized recipients
#    - Add recipient emails in Mailgun dashboard under "Authorized Recipients"
#    - Consider upgrading to verified domain for production
# 
# ⚠️  AFRICA'S TALKING NOTES:
#    - Minimum KES 100 recommended for production testing
#    - Register sender ID for branded SMS (optional)
#    - Kenya SMS cost: ~KES 0.80 per SMS
# 
# 📋 SECURITY VALIDATION:
#    Run: npm run validate:env
#    This will check all security configurations before deployment.

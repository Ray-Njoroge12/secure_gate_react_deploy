# Production Environment Configuration
# Copy to .env for production deployment
# 
# ⚠️  NEVER commit .env files to version control!

# ==========================================
# Application Environment
# ==========================================
NODE_ENV=production
PORT=5000

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
PGUSER=postgres
PGPASSWORD=your-strong-database-password
PGHOST=your-rds-endpoint.af-south-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=secure_gate

# Database Connection Pool
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=5000

# ==========================================
# JWT Authentication & Security Secrets
# ==========================================
JWT_SECRET=your-64-byte-cryptographic-secret
JWT_REFRESH_SECRET=your-64-byte-cryptographic-secret
SESSION_SECRET=your-64-byte-cryptographic-secret

# JWT Token Expiration (minutes)
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=10080

# ==========================================
# Security & Transport Configuration
# ==========================================
ENFORCE_HTTPS=true
SECURE_COOKIES=true
TRUST_PROXY=true

# Transport Layer Security
HSTS_MAX_AGE=63072000
ENABLE_HPKP=false

# CORS Configuration
CLIENT_ORIGIN=https://your-production-frontend-url.com
ADDITIONAL_ORIGINS=

# ==========================================
# Rate Limiting Configuration
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3

# ==========================================
# Redis Configuration
# ==========================================
REDIS_URL=redis://your-elasticache-endpoint:6379

# ==========================================
# Email/SMS Configuration - YOUR CREDENTIALS
# ==========================================
# Mailgun Configuration (US Servers)
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=CHANGEME_YOUR_PRODUCTION_MAILGUN_API_KEY
MAILGUN_DOMAIN=your-verified-domain.com
MAILGUN_BASE_URL=https://api.mailgun.net
EMAIL_FROM=noreply@your-verified-domain.com

# Africa's Talking Configuration (Production)
SMS_PROVIDER=africastalking
AT_USERNAME=CHANGEME_YOUR_PRODUCTION_AT_USERNAME
AT_API_KEY=CHANGEME_YOUR_PRODUCTION_AT_API_KEY
AT_SENDER_ID=

# ==========================================
# Data Encryption Configuration
# ==========================================
# AWS KMS Configuration (PRODUCTION RECOMMENDED)
ENCRYPTION_METHOD=aws-kms
AWS_KMS_KEY_ID=a6f0e074-dd01-4dca-bfc9-dea248f04e45
AWS_REGION=af-south-1

# Local Encryption Key (NOT for production, only for development)
ENCRYPTION_KEY=

# ==========================================
# Site Configuration
# ==========================================
SITE_NAME=Secure Gate Access
SITE_URL=https://your-production-backend-url.com
FRONTEND_URL=https://your-production-frontend-url.com

# ==========================================
# Feature Flags & Development Settings
# ==========================================
OTP_DEBUG_ECHO=false
OTP_TTL_MINUTES=15
ALERT_ON_OTP_FAILS=true

# Cron Job Configuration
CRON_INVITE_LIFECYCLE=0 * * * *
CRON_VISITOR_EXPIRE=0 2 * * *

# ==========================================
# NOTES - CURRENT SETUP
# ==========================================
# ✅ Mailgun API Key: Full API access (not just sending key)
# ✅ Africa's Talking Credits: KES 160 (~200 SMS)
# ✅ Authorized Recipients: n91599727@gmail.com, nn0200774@gmail.com
# ⚠️  Mailgun Sandbox: Can only send to authorized recipients
# ⚠️  To send to any email: Verify a custom domain in Mailgun
# ✅ AWS KMS Key: Enabled in af-south-1 region

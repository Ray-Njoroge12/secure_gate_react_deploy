# =====================================================
# LOCAL DEVELOPMENT ENVIRONMENT (WITH SMS/EMAIL)
# Copy to .env.local for local development
# =====================================================

# Core Settings
NODE_ENV=development
PORT=3001

# Database (Local PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=secure_gate
PGUSER=postgres
PGPASSWORD=postgres

# Redis (Local - optional for dev)
REDIS_URL=redis://localhost:6379

# JWT Secrets (CHANGE THESE!)
JWT_SECRET=local-dev-jwt-secret-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-this-in-production-32
SESSION_SECRET=local-dev-session-secret-change-this-in-production-32

# MFA Key
MFA_ENCRYPTION_KEY=local-dev-mfa-key-change-this-in-production-min-32-ch
ENCRYPTION_KEY=local-dev-encryption-key-change-this-in-production-32

# CORS (React dev server)
CORS_ORIGIN=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# URLs
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000
SITE_NAME=Secure Gate Access

# =====================================================
# AFRICA'S TALKING (SMS)
# =====================================================
SMS_PROVIDER=africastalking
AT_USERNAME=securelabstest
AT_API_KEY=YOUR_ROTATED_AT_API_KEY_HERE
# AT_SENDER_ID=SecureGate  # Uncomment when approved

# =====================================================
# MAILGUN (EMAIL)
# =====================================================
EMAIL_PROVIDER=mailgun
MAILGUN_DOMAIN=sandboxcd6106b9f4d54da78846462008c1678b.mailgun.org
MAILGUN_API_KEY=YOUR_ROTATED_MAILGUN_API_KEY_HERE
MAILGUN_BASE_URL=https://api.mailgun.net
EMAIL_FROM=Secure Gate <postmaster@sandboxcd6106b9f4d54da78846462008c1678b.mailgun.org>
EMAIL_FROM_NAME=Secure Gate Access

# =====================================================
# NOTIFICATION FLAGS
# =====================================================
ENABLE_EXTERNAL_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true

# =====================================================
# DEVELOPMENT FLAGS
# =====================================================
EMAIL_VERIFICATION_REQUIRED=false
OTP_DEBUG_ECHO=true
LOG_LEVEL=debug
ENFORCE_HTTPS=false

# Rate Limiting (relaxed for dev)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=100

# =====================================================
# NOTE: Replace YOUR_ROTATED_*_KEY_HERE with your
# actual API keys. Keep this file secure!
# =====================================================

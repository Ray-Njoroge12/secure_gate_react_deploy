/**
 * Smoke Test: Database Connection
 * Verifies that database is accessible and responding
 */

import { describe, test, expect, beforeAll, afterAll } from '@jest/globals';
import dbManager from '../../src/database/db.enhanced.js';

describe('Smoke Test: Database Connection', () => {
  test('should connect to database successfully', async () => {
    // Database manager auto-initializes, just test connection
    await dbManager.testConnection();

    const status = dbManager.getStatus();
    expect(status).toBeDefined();
    expect(status.isConnected).toBe(true);
  }, 10000);

  test('should execute simple query', async () => {
    const result = await dbManager.query('SELECT 1 as test');

    expect(result).toBeDefined();
    expect(result.rows).toBeDefined();
    expect(result.rows.length).toBe(1);
    expect(result.rows[0].test).toBe(1);
  }, 10000);

  test('should verify critical tables exist', async () => {
    const tables = ['users', 'visitors', 'events', 'event_visitors', 'estate_locations'];

    for (const tableName of tables) {
      const result = await dbManager.query(
        `SELECT EXISTS (
          SELECT FROM information_schema.tables
          WHERE table_schema = 'public'
          AND table_name = $1
        )`,
        [tableName]
      );

      expect(result.rows[0].exists).toBe(true);
    }
  }, 15000);

  test('should verify E2 columns exist in visitors table', async () => {
    const result = await dbManager.query(
      `SELECT column_name, data_type
       FROM information_schema.columns
       WHERE table_name = 'visitors'
       AND column_name IN ('consent_data', 'additional_info', 'consent_given_at')
       ORDER BY column_name`
    );

    expect(result.rows.length).toBe(3);

    const columns = result.rows.map(r => r.column_name);
    expect(columns).toContain('consent_data');
    expect(columns).toContain('additional_info');
    expect(columns).toContain('consent_given_at');
  }, 10000);

  test('should verify E3 analytics views exist', async () => {
    const views = ['event_analytics', 'upcoming_events', 'event_checkin_queue'];

    for (const viewName of views) {
      const result = await dbManager.query(
        `SELECT EXISTS (
          SELECT FROM information_schema.views
          WHERE table_schema = 'public'
          AND table_name = $1
        )`,
        [viewName]
      );

      expect(result.rows[0].exists).toBe(true);
    }
  }, 15000);
});

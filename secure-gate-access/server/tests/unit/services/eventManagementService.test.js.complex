/**
 * Unit Tests: EventManagementService (E3)
 * Tests event management and analytics functionality
 */

import { describe, test, expect, jest, beforeEach, afterEach } from '@jest/globals';

// Mock dependencies
const mockDb = {
  query: jest.fn(),
};

const mockLoggingService = {
  logInfo: jest.fn(),
  logError: jest.fn(),
  logWarn: jest.fn(),
};

const mockNotificationQueueService = {
  default: {
    queueEmail: jest.fn(),
    queueSMS: jest.fn(),
  },
};

const mockCalendarService = {
  default: {
    generateICalEvent: jest.fn(),
  },
};

// Mock modules
jest.unstable_mockModule('../../../src/database/db.enhanced.js', () => ({
  default: mockDb,
}));

jest.unstable_mockModule('../../../src/services/loggingService.js', () => ({
  default: mockLoggingService,
}));

jest.unstable_mockModule('../../../src/services/notificationQueueService.js', () => mockNotificationQueueService);

jest.unstable_mockModule('../../../src/services/calendarService.js', () => mockCalendarService);

// Import after mocking
const eventManagementServiceModule = await import('../../../src/services/eventManagementService.js');
const service = eventManagementServiceModule.default;

describe('EventManagementService Unit Tests (E3)', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  afterEach(() => {
    jest.clearAllMocks();
  });

  describe('createEvent', () => {
    const validEventData = {
      name: 'New Year Party 2026',
      description: 'Annual celebration',
      event_type: 'party',
      location: 'Main Hall',
      start_date: '2026-01-01T19:00:00Z',
      end_date: '2026-01-02T02:00:00Z',
      max_capacity: 100,
      status: 'published',
    };

    test('should create event with valid data', async () => {
      // Arrange
      const hostId = 1;
      const estateId = 1;
      const mockEvent = {
        id: 1,
        ...validEventData,
        host_id: hostId,
        estate_id: estateId,
        qr_code_prefix: 'NEWY',
        created_at: new Date(),
      };

      mockDb.query.mockResolvedValue({ rows: [mockEvent] });

      // Act
      const result = await service.createEvent(validEventData, hostId, estateId);

      // Assert
      expect(result).toBeDefined();
      expect(result.id).toBe(1);
      expect(result.name).toBe('New Year Party 2026');
      expect(mockDb.query).toHaveBeenCalledTimes(1);
      expect(mockLoggingService.logInfo).toHaveBeenCalledWith(
        'Event created',
        expect.objectContaining({ eventId: 1 })
      );
    });

    test('should generate QR code prefix if not provided', async () => {
      // Arrange
      mockDb.query.mockResolvedValue({
        rows: [{
          id: 1,
          ...validEventData,
          qr_code_prefix: 'NEWY',
        }],
      });

      // Act
      await service.createEvent(validEventData, 1, 1);

      // Assert
      const callArgs = mockDb.query.mock.calls[0][1];
      expect(callArgs[20]).toBeDefined(); // qr_code_prefix argument
      expect(typeof callArgs[20]).toBe('string');
    });

    test('should set default values for optional fields', async () => {
      // Arrange
      const minimalEventData = {
        name: 'Test Event',
        start_date: '2026-01-01T10:00:00Z',
        end_date: '2026-01-01T12:00:00Z',
      };

      mockDb.query.mockResolvedValue({
        rows: [{
          id: 1,
          ...minimalEventData,
          event_type: 'other',
          requires_approval: false,
          allow_plus_one: false,
          send_reminders: true,
        }],
      });

      // Act
      const result = await service.createEvent(minimalEventData, 1, 1);

      // Assert
      expect(result).toBeDefined();
      const callArgs = mockDb.query.mock.calls[0][1];
      expect(callArgs[2]).toBe('other'); // event_type default
      expect(callArgs[16]).toBe(false); // requires_approval default
      expect(callArgs[17]).toBe(false); // allow_plus_one default
      expect(callArgs[18]).toBe(true); // send_reminders default
    });

    test('should handle database errors', async () => {
      // Arrange
      mockDb.query.mockRejectedValue(new Error('Database error'));

      // Act & Assert
      await expect(service.createEvent(validEventData, 1, 1)).rejects.toThrow('Database error');
      expect(mockLoggingService.logError).toHaveBeenCalled();
    });
  });

  describe('getEventById', () => {
    test('should retrieve event with analytics', async () => {
      // Arrange
      const mockEvent = {
        id: 1,
        name: 'Test Event',
        total_invited: 10,
        confirmed_count: 8,
        rsvp_attending: 7,
        checked_in_count: 5,
        rsvp_response_rate: 80.0,
        attendance_rate: 71.43,
      };

      mockDb.query.mockResolvedValue({ rows: [mockEvent] });

      // Act
      const result = await service.getEventById(1);

      // Assert
      expect(result).toBeDefined();
      expect(result.id).toBe(1);
      expect(result.total_invited).toBe(10);
      expect(result.rsvp_response_rate).toBe(80.0);
      expect(mockDb.query).toHaveBeenCalledWith(
        expect.stringContaining('event_analytics'),
        [1]
      );
    });

    test('should return null for non-existent event', async () => {
      // Arrange
      mockDb.query.mockResolvedValue({ rows: [] });

      // Act
      const result = await service.getEventById(999);

      // Assert
      expect(result).toBeNull();
    });

    test('should handle database errors', async () => {
      // Arrange
      mockDb.query.mockRejectedValue(new Error('Database connection failed'));

      // Act & Assert
      await expect(service.getEventById(1)).rejects.toThrow();
      expect(mockLoggingService.logError).toHaveBeenCalled();
    });
  });

  describe('handleRSVP', () => {
    test('should update RSVP status', async () => {
      // Arrange
      const eventVisitorId = 1;
      const mockUpdated = {
        id: 1,
        event_id: 1,
        visitor_id: 1,
        rsvp_status: 'attending',
        plus_one_count: 1,
        updated_at: new Date(),
      };

      mockDb.query.mockResolvedValue({ rows: [mockUpdated] });

      // Act
      const result = await service.handleRSVP(eventVisitorId, 'attending', {
        plusOneCount: 1,
        plusOneNames: ['Guest Name'],
      });

      // Assert
      expect(result).toBeDefined();
      expect(result.rsvp_status).toBe('attending');
      expect(mockDb.query).toHaveBeenCalled();
    });

    test('should accept different RSVP statuses', async () => {
      // Arrange
      mockDb.query.mockResolvedValue({
        rows: [{ id: 1, rsvp_status: 'not_attending' }],
      });

      // Act
      await service.handleRSVP(1, 'not_attending');

      // Assert
      expect(mockDb.query).toHaveBeenCalled();
    });

    test('should handle plus-one details', async () => {
      // Arrange
      mockDb.query.mockResolvedValue({
        rows: [{
          id: 1,
          plus_one_count: 2,
          plus_one_names: ['Guest 1', 'Guest 2'],
        }],
      });

      // Act
      await service.handleRSVP(1, 'attending', {
        plusOneCount: 2,
        plusOneNames: ['Guest 1', 'Guest 2'],
      });

      // Assert
      expect(mockDb.query).toHaveBeenCalled();
    });
  });

  describe('checkInToEvent', () => {
    test('should check in visitor with valid QR code', async () => {
      // Arrange
      const qrCode = 'EVENT123-VISITOR456';
      const mockCheckIn = {
        id: 1,
        check_in_time: new Date(),
        checked_in_by: 1,
      };

      mockDb.query.mockResolvedValue({ rows: [mockCheckIn] });

      // Act
      const result = await service.checkInToEvent(qrCode);

      // Assert
      expect(result).toBeDefined();
      expect(result.check_in_time).toBeDefined();
      expect(mockDb.query).toHaveBeenCalled();
    });

    test('should handle invalid QR code', async () => {
      // Arrange
      mockDb.query.mockResolvedValue({ rows: [] });

      // Act & Assert
      await expect(service.checkInToEvent('INVALID-QR')).rejects.toThrow();
    });
  });

  describe('checkOutFromEvent', () => {
    test('should check out visitor with valid QR code', async () => {
      // Arrange
      const qrCode = 'EVENT123-VISITOR456';
      const mockCheckOut = {
        id: 1,
        check_out_time: new Date(),
        checked_out_by: 1,
      };

      mockDb.query.mockResolvedValue({ rows: [mockCheckOut] });

      // Act
      const result = await service.checkOutFromEvent(qrCode);

      // Assert
      expect(result).toBeDefined();
      expect(result.check_out_time).toBeDefined();
    });
  });

  describe('getEventStatistics', () => {
    test('should return comprehensive event statistics', async () => {
      // Arrange
      const mockStats = {
        total_invited: 100,
        confirmed_count: 85,
        declined_count: 5,
        pending_count: 10,
        rsvp_attending: 80,
        rsvp_not_attending: 5,
        rsvp_maybe: 0,
        checked_in_count: 75,
        checked_out_count: 70,
        total_plus_ones: 20,
        rsvp_response_rate: 90.0,
        attendance_rate: 93.75,
      };

      mockDb.query.mockResolvedValue({ rows: [mockStats] });

      // Act
      const result = await service.getEventStatistics(1);

      // Assert
      expect(result).toBeDefined();
      expect(result.total_invited).toBe(100);
      expect(result.rsvp_response_rate).toBe(90.0);
      expect(result.attendance_rate).toBe(93.75);
      expect(result.checked_in_count).toBe(75);
    });

    test('should handle events with no attendees', async () => {
      // Arrange
      mockDb.query.mockResolvedValue({
        rows: [{
          total_invited: 0,
          confirmed_count: 0,
          rsvp_response_rate: 0,
          attendance_rate: 0,
        }],
      });

      // Act
      const result = await service.getEventStatistics(1);

      // Assert
      expect(result).toBeDefined();
      expect(result.total_invited).toBe(0);
    });
  });

  describe('generateQRCodePrefix', () => {
    test('should generate QR code prefix from event name', () => {
      // Act
      const prefix = service.generateQRCodePrefix('New Year Party 2026');

      // Assert
      expect(prefix).toBeDefined();
      expect(typeof prefix).toBe('string');
      expect(prefix.length).toBeGreaterThan(0);
    });

    test('should generate different prefixes for different names', () => {
      // Act
      const prefix1 = service.generateQRCodePrefix('Summer BBQ');
      const prefix2 = service.generateQRCodePrefix('Winter Gala');

      // Assert
      expect(prefix1).not.toBe(prefix2);
    });

    test('should handle special characters in event name', () => {
      // Act
      const prefix = service.generateQRCodePrefix("Company's 50th Anniversary!");

      // Assert
      expect(prefix).toBeDefined();
      expect(typeof prefix).toBe('string');
    });
  });

  describe('updateEvent', () => {
    test('should update event details', async () => {
      // Arrange
      const updates = {
        name: 'Updated Event Name',
        max_capacity: 150,
      };

      mockDb.query.mockResolvedValue({
        rows: [{
          id: 1,
          name: 'Updated Event Name',
          max_capacity: 150,
        }],
      });

      // Act
      const result = await service.updateEvent(1, updates);

      // Assert
      expect(result).toBeDefined();
      expect(result.name).toBe('Updated Event Name');
      expect(result.max_capacity).toBe(150);
    });

    test('should handle partial updates', async () => {
      // Arrange
      const updates = { max_capacity: 200 };

      mockDb.query.mockResolvedValue({
        rows: [{ id: 1, max_capacity: 200 }],
      });

      // Act
      const result = await service.updateEvent(1, updates);

      // Assert
      expect(result).toBeDefined();
      expect(mockDb.query).toHaveBeenCalled();
    });
  });

  describe('deleteEvent', () => {
    test('should delete event by ID', async () => {
      // Arrange
      mockDb.query.mockResolvedValue({ rowCount: 1 });

      // Act
      const result = await service.deleteEvent(1);

      // Assert
      expect(result).toBe(true);
      expect(mockDb.query).toHaveBeenCalled();
    });

    test('should return false if event not found', async () => {
      // Arrange
      mockDb.query.mockResolvedValue({ rowCount: 0 });

      // Act
      const result = await service.deleteEvent(999);

      // Assert
      expect(result).toBe(false);
    });
  });
});

# =====================================================
# Secure Gate Access Control System
# Environment Variables Template
# 
# Copy this file to .env.local, .env.staging, or .env.production
# and fill in the appropriate values for your environment
# =====================================================

# ================== ENVIRONMENT ==================
NODE_ENV=development  # development | staging | production
PORT=5000
API_VERSION=v1
DEPLOYMENT_ENV=local  # local | staging | production

# ================== DATABASE ==================
# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=secure_gate
PGUSER=postgres  # Standardized to 'postgres'
PGPASSWORD=postgres  # CHANGE IN PRODUCTION

# Connection Pool Settings
PGPOOL_MAX=20
PGPOOL_MIN=2
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=5000
PGPOOL_ACQUIRE_TIMEOUT=10000
PGPOOL_KEEPALIVE_DELAY=10000
PGPOOL_MAX_RETRY=5
PGPOOL_RETRY_DELAY=2000
PGPOOL_MAX_RETRY_DELAY=30000
PGPOOL_HEALTH_INTERVAL=30000

# Legacy DB variables (for backward compatibility)
DB_HOST=${PGHOST}
DB_PORT=${PGPORT}
DB_NAME=${PGDATABASE}
DB_USER=${PGUSER}
DB_PASSWORD=${PGPASSWORD}

# ================== AUTHENTICATION ==================
# JWT Configuration (MUST be at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-chars  # CHANGE THIS
JWT_REFRESH_SECRET=your-refresh-secret-must-be-at-least-32-chars  # CHANGE THIS
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=secure-gate

# MFA Configuration (MUST be at least 32 characters)
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-at-least-32-characters  # CHANGE THIS
MFA_ISSUER=SecureGate
MFA_MAX_ATTEMPTS=3
MFA_LOCKOUT_DURATION=300000  # 5 minutes

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900000  # 15 minutes

# ================== REDIS ==================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty for local
REDIS_DB=0
REDIS_KEY_PREFIX=sg:
REDIS_ENABLE_CLUSTER=false
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=5000
REDIS_ENABLE_TLS=false

# ================== EMAIL (SMTP) ==================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false  # true for 465, false for other ports
SMTP_USER=  # Your email
SMTP_PASSWORD=  # App-specific password
SMTP_FROM=noreply@securegate.com
SMTP_FROM_NAME=Secure Gate System

# ================== SMS PROVIDERS ==================
SMS_PROVIDER=none  # twilio | africastalking | none

# Twilio Configuration
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Africa's Talking Configuration
AFRICASTALKING_ENABLED=false
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ================== THIRD PARTY SERVICES ==================
# AWS Configuration (for production)
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
USE_AWS_SECRETS_MANAGER=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# ================== SECURITY ==================
# CORS Configuration
CORS_ORIGIN=http://localhost:3000  # Frontend URL
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=your-session-secret-at-least-32-characters  # CHANGE THIS
SESSION_MAX_AGE=86400000  # 24 hours

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
REGISTRATION_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_MAX=3

# Security Headers
ENABLE_HELMET=true
ENABLE_HTTPS_REDIRECT=false  # Set to true in production
HSTS_MAX_AGE=31536000
CSP_ENABLED=false  # Content Security Policy
X_POWERED_BY_HEADER=false

# ================== FEATURES FLAGS ==================
ENABLE_MFA=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_WEBSOCKETS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_VISITOR_SELF_CHECKIN=true
ENABLE_RESIDENT_APPROVAL=true
ENABLE_VISITOR_PHOTOS=true
ENABLE_QR_CODES=true
ENABLE_BULK_INVITES=true
ENABLE_REPORTING=true
ENABLE_ANALYTICS=true
ENABLE_BACKUP_SERVICE=true
ENABLE_MONITORING_DASHBOARD=false

# ================== MONITORING & LOGGING ==================
LOG_LEVEL=info  # error | warn | info | debug
LOG_FORMAT=json  # json | simple
LOG_TO_FILE=true
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14
LOG_ROTATION=daily

# Monitoring
MONITORING_ENABLED=false
MONITORING_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# ================== BACKUP ==================
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_LOCAL_PATH=./backups

# ================== MISCELLANEOUS ==================
# File Upload
MAX_FILE_SIZE=5242880  # 5MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Cache
CACHE_TTL=300  # 5 minutes
CACHE_ENABLED=true

# Timezone
TZ=Africa/Nairobi

# Frontend URLs (for emails, redirects)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
PUBLIC_API_URL=http://localhost:5000

# ================== TESTING ==================
# Test Database (used when NODE_ENV=test)
TEST_PGHOST=localhost
TEST_PGPORT=5432
TEST_PGDATABASE=secure_gate_test
TEST_PGUSER=postgres
TEST_PGPASSWORD=postgres

# Test Redis
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379

# =====================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =====================================================

# For .env.local - Use defaults above

# For .env.staging - Override:
# NODE_ENV=staging
# ENABLE_HTTPS_REDIRECT=true
# LOG_LEVEL=warn
# Use staging database/redis

# For .env.production - Override:
# NODE_ENV=production
# ENABLE_HTTPS_REDIRECT=true
# LOG_LEVEL=error
# Use production database/redis
# Enable all security features
# Use AWS Secrets Manager for sensitive values

# =====================================================
# NOTES:
# 1. All secrets MUST be changed from defaults
# 2. Use AWS Secrets Manager in production
# 3. Never commit actual .env files to git
# 4. Rotate secrets regularly
# 5. Use strong, unique passwords
# =====================================================

# =============================================================================
# Secure Gate Access Control — Server Test Environment Variables
# Copy this file to .env.test for local/integration test runs.
# NEVER commit .env.test to version control.
# =============================================================================

PORT=3002
NODE_ENV=test
LOG_LEVEL=error

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_gate_test?sslmode=disable
PGSSLMODE=disable
PGPOOL_MAX=5
PGPOOL_MIN=1
PGPOOL_IDLE_TIMEOUT=1000

# Test-only secrets (replace for your local setup)
JWT_SECRET=test-secret-key-change-me-1234567890
JWT_REFRESH_SECRET=test-refresh-secret-key-change-me-1234567890
SESSION_SECRET=test-session-secret-key-change-me-1234567890
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Test Environment Configuration
# For local development and testing
# Copy to .env for local testing

# ==========================================
# Application Environment
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Database Configuration (Local PostgreSQL)
# ==========================================
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=secure_gate

PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=5000

# ==========================================
# JWT Authentication & Security Secrets
# ==========================================
# DEVELOPMENT ONLY - Generate new secrets for production
JWT_SECRET=dev_jwt_secret_replace_in_production_with_64_byte_secret
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_production_with_64_byte_secret
SESSION_SECRET=dev_session_secret_replace_in_production_with_64_byte_secret

JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=10080

# ==========================================
# Security & Transport Configuration
# ==========================================
ENFORCE_HTTPS=false
SECURE_COOKIES=false
TRUST_PROXY=false

HSTS_MAX_AGE=63072000
ENABLE_HPKP=false

# CORS Configuration
CLIENT_ORIGIN=http://localhost:3000
ADDITIONAL_ORIGINS=

# ==========================================
# Rate Limiting Configuration
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3

# ==========================================
# Redis Configuration (Optional for development)
# ==========================================
REDIS_URL=

# ==========================================
# Email/SMS Configuration
# ==========================================
# Mailgun Configuration
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=CHANGEME_YOUR_MAILGUN_API_KEY
MAILGUN_DOMAIN=your-domain.mailgun.org
MAILGUN_BASE_URL=https://api.mailgun.net
EMAIL_FROM=noreply@your-domain.mailgun.org

# Africa's Talking Configuration
SMS_PROVIDER=africastalking
AT_USERNAME=CHANGEME_YOUR_AT_USERNAME
AT_API_KEY=CHANGEME_YOUR_AT_API_KEY
AT_SENDER_ID=

# ==========================================
# Data Encryption Configuration
# ==========================================
# Use local encryption for development (AWS KMS for production)
ENCRYPTION_METHOD=local
ENCRYPTION_KEY=vA5ByuEqYfptK78H0PG7XdI4KcJNDdYjt5joFMlJnH0=

# AWS KMS (for testing production encryption)
AWS_KMS_KEY_ID=a6f0e074-dd01-4dca-bfc9-dea248f04e45
AWS_REGION=af-south-1

# ==========================================
# Site Configuration
# ==========================================
SITE_NAME=Secure Gate Access
SITE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ==========================================
# Feature Flags & Development Settings
# ==========================================
OTP_DEBUG_ECHO=true
OTP_TTL_MINUTES=15
ALERT_ON_OTP_FAILS=false

CRON_INVITE_LIFECYCLE=0 * * * *
CRON_VISITOR_EXPIRE=0 2 * * *

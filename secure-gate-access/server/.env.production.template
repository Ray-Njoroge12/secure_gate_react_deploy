# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# 
# CRITICAL: This file contains sensitive information
# - DO NOT commit to version control
# - Store in secure secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Rotate keys regularly
# - Use environment-specific values
#
# Generated: January 7, 2026
# ============================================

# --------------------------------------------
# Application Environment
# --------------------------------------------
NODE_ENV=production
PORT=5000

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# Replace with your production database URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://username:password@your-db-host.com:5432/secure_gate_production

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# --------------------------------------------
# Security - Encryption
# --------------------------------------------
# GENERATED KEY (64 hex characters)
# ⚠️ CRITICAL: Store this key securely!
# ⚠️ If lost, encrypted data cannot be recovered
# ⚠️ Rotate periodically and re-encrypt data
ENCRYPTION_KEY=bc3fbc1252c80cbf460bdd4926b9059085676f6fb4949210dcb2432dbc3bc6a3

# Encryption Algorithm (do not change unless re-encrypting all data)
ENCRYPTION_ALGORITHM=aes-256-gcm

# --------------------------------------------
# Security - JWT Tokens
# --------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_REFRESH_SECRET_MINIMUM_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --------------------------------------------
# Security - OTP Settings
# --------------------------------------------
# ⚠️ CRITICAL: MUST be false in production!
# Setting to true will expose OTPs in logs (SECURITY RISK!)
OTP_DEBUG_ECHO=false

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# --------------------------------------------
# Security - Data Retention
# --------------------------------------------
# Enable automatic data retention and archival
RETENTION_ARCHIVE_ENABLED=true

# Retention periods (in days)
RETENTION_VISITOR_DAYS=90
RETENTION_ACCESS_LOG_DAYS=365
RETENTION_AUDIT_LOG_DAYS=730

# When to run retention job (cron format)
# Default: 2:00 AM daily
# Format: minute hour day month day-of-week
RETENTION_CRON_SCHEDULE=0 2 * * *

# Batch size for retention operations
RETENTION_BATCH_SIZE=1000

# --------------------------------------------
# Security - QR Code Tokens
# --------------------------------------------
# How long QR tokens remain valid (in hours)
QR_TOKEN_EXPIRY_HOURS=24

# QR token length (characters)
QR_TOKEN_LENGTH=32

# --------------------------------------------
# Email Configuration
# --------------------------------------------
# SMTP settings for email notifications
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@securegateccess.com

# --------------------------------------------
# SMS/WhatsApp Configuration
# --------------------------------------------
# Twilio credentials for SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API (if using)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# --------------------------------------------
# Redis Configuration (if using for caching)
# --------------------------------------------
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/secure-gate/app.log
LOG_MAX_SIZE=10M
LOG_MAX_FILES=7

# Enable different log types
LOG_REQUESTS=true
LOG_QUERIES=false
LOG_ERRORS=true
LOG_SECURITY=true

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Allowed origins for CORS (comma-separated)
CORS_ORIGIN=https://app.securegataccess.com,https://admin.securegateaccess.com

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# File Upload Configuration
# --------------------------------------------
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# --------------------------------------------
# Session Configuration
# --------------------------------------------
SESSION_SECRET=REPLACE_WITH_SECURE_SESSION_SECRET_MINIMUM_32_CHARS
SESSION_MAX_AGE=86400000

# --------------------------------------------
# Feature Flags
# --------------------------------------------
FEATURE_QR_TOKENIZATION=true
FEATURE_DATA_RETENTION=true
FEATURE_DATA_MINIMIZATION=true
FEATURE_ID_ENCRYPTION=true
FEATURE_WHATSAPP_NOTIFICATIONS=false

# --------------------------------------------
# Monitoring & Analytics
# --------------------------------------------
# Application Performance Monitoring
APM_ENABLED=true
APM_SERVICE_NAME=secure-gate-api
APM_SERVER_URL=https://apm.your-domain.com

# Error Tracking (e.g., Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --------------------------------------------
# Backup Configuration
# --------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=secure-gate-backups
BACKUP_S3_REGION=us-east-1

# --------------------------------------------
# AWS Configuration (if using)
# --------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# S3 for file storage
S3_BUCKET_NAME=secure-gate-uploads
S3_BUCKET_REGION=us-east-1

# --------------------------------------------
# Admin Configuration
# --------------------------------------------
ADMIN_EMAIL=admin@securegateaccess.com
SUPPORT_EMAIL=support@securegateaccess.com

# Default admin user (for initial setup only)
DEFAULT_ADMIN_EMAIL=admin@securegateaccess.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# --------------------------------------------
# Compliance & Security Headers
# --------------------------------------------
ENABLE_HELMET=true
ENABLE_CSRF_PROTECTION=true
ENABLE_XSS_PROTECTION=true
ENABLE_RATE_LIMITING=true

# --------------------------------------------
# Development/Debugging (Production: all false)
# --------------------------------------------
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_API_DOCS=false
ENABLE_PROFILING=false

# ============================================
# END OF PRODUCTION CONFIGURATION
# ============================================

# DEPLOYMENT CHECKLIST:
# [ ] Replace all placeholder values with actual production values
# [ ] Generate and set JWT_SECRET and JWT_REFRESH_SECRET
# [ ] Verify ENCRYPTION_KEY is securely stored
# [ ] Confirm OTP_DEBUG_ECHO=false
# [ ] Set correct database connection string
# [ ] Configure email/SMS providers
# [ ] Set up monitoring and error tracking
# [ ] Verify CORS origins match your domains
# [ ] Store this file in secure secrets manager
# [ ] Never commit this file to version control

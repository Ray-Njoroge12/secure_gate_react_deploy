# ============================================================
# SECURE GATE ACCESS - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# IMPORTANT: Copy this to .env.production and fill in real values
# NEVER commit .env.production to version control!
# ============================================================

# ===================
# CORE APPLICATION
# ===================
NODE_ENV=production
PORT=3001

# Site Configuration
SITE_NAME="Secure Gate Access"
SITE_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
CLIENT_ORIGIN=https://app.yourdomain.com

# ===================
# SECURITY (CRITICAL)
# ===================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=CHANGE_ME_GENERATE_64_BYTE_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_64_BYTE_SECRET
SESSION_SECRET=CHANGE_ME_GENERATE_64_BYTE_SECRET
ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_BYTE_SECRET

# Production Security Settings
ENFORCE_HTTPS=true
SECURE_COOKIES=true
TRUST_PROXY=true

# ===================
# DATABASE (PostgreSQL)
# ===================
PGHOST=your-rds-endpoint.af-south-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=secure_gate
PGUSER=securegate_admin
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=5000

# ===================
# REDIS (Token Blacklist & Rate Limiting)
# ===================
REDIS_URL=redis://your-elasticache-endpoint:6379
REDIS_PASSWORD=CHANGE_ME_IF_NEEDED

# ===================
# EMAIL - MAILGUN
# ===================
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=CHANGE_ME_MAILGUN_PRIVATE_API_KEY
MAILGUN_DOMAIN=sandboxcd6106b9f4d54da78846462008c1678b.mailgun.org
MAILGUN_BASE_URL=https://api.mailgun.net
EMAIL_FROM=Secure Gate <postmaster@sandboxcd6106b9f4d54da78846462008c1678b.mailgun.org>
EMAIL_FROM_NAME=Secure Gate Access

# Optional: Mailgun webhooks (for delivery tracking)
MAILGUN_WEBHOOK_SIGNING_KEY=CHANGE_ME_IF_USING_WEBHOOKS

# ===================
# SMS - AFRICA'S TALKING
# ===================
SMS_PROVIDER=africastalking
AT_USERNAME=securelabstest
AT_API_KEY=CHANGE_ME_AFRICASTALKING_API_KEY
# AT_SENDER_ID=SecureGate  # Uncomment when you have approved sender ID

# ===================
# NOTIFICATION FLAGS
# ===================
ENABLE_EXTERNAL_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true

# ===================
# MFA CONFIGURATION
# ===================
MFA_ISSUER=SecureGate
MFA_ENABLED=true

# ===================
# RATE LIMITING
# ===================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3

# ===================
# AWS SECRETS MANAGER (Optional - secrets auto-loaded in production)
# ===================
USE_AWS_SECRETS=true
SECRETS_PREFIX=secure-gate-prod
AWS_REGION=af-south-1

# ===================
# LOGGING
# ===================
LOG_LEVEL=info

# ===================
# DEBUG FLAGS (MUST BE OFF IN PRODUCTION)
# ===================
OTP_DEBUG_ECHO=false
EMAIL_VERIFICATION_REQUIRED=true

# Docker ignore file for Secure Gate Backend
# Exclude unnecessary files from Docker build context

# Development files
tests/
scripts/
reports/
*.log
*.log.*

# Node modules (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (will be copied separately)
.env
.env.local
.env.development
.env.test

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Backup files
*.backup
*.bak

# Temporary files
tmp/
temp/


{
  "name": "secure-gate-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Secure Gate Access Control System - Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --inspect server.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --runInBand --coverage",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --runInBand --watch",
    "test:unit": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.unit.cjs --runInBand",
    "test:unit:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.unit.cjs --runInBand --coverage",
    "test:unit:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.unit.cjs --runInBand --watch",
    "test:integration": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.integration.cjs --runInBand --detectOpenHandles",
    "test:integration:verbose": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.integration.cjs --runInBand --verbose",
    "test:integration:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.integration.cjs --runInBand --coverage",
    "test:e2e": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.e2e.cjs --runInBand",
    "test:e2e:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.e2e.cjs --runInBand --coverage",
    "test:playwright": "npx playwright test",
    "test:playwright:headed": "npx playwright test --headed",
    "test:playwright:ui": "npx playwright test --ui",
    "test:playwright:debug": "npx playwright test --debug",
    "test:playwright:report": "npx playwright show-report",
    "test:playwright:install": "npx playwright install",
    "test:manual": "node tests/manual/execute-manual-tests.js",
    "test:manual:run": "node tests/manual/run-manual-tests.js",
    "test:manual:report": "open tests/results/manual-test-report.html",
    "test:performance": "node tests/performance/run-performance-tests.js",
    "test:performance:comprehensive": "node tests/performance/comprehensive-performance-test.js",
    "test:performance:monitor": "node tests/performance/monitor-dashboard.js",
    "test:performance:load": "k6 run tests/performance/load-test.js",
    "test:performance:stress": "k6 run tests/performance/stress-test.js",
    "test:performance:spike": "k6 run tests/performance/spike-test.js",
    "test:security": "node tests/security/run-security-audit.js",
    "test:security:audit": "node tests/security/security-audit.js",
    "test:security:vulnerability": "node tests/security/vulnerability-tests.js",
    "test:security:npm": "npm audit",
    "test:all": "npm run test:integration && npm run test:e2e && npm run test:manual && npm run test:performance && npm run test:security",
    "optimize:database": "node scripts/optimize-database.js",
    "setup:env": "node scripts/setup-env.js",
    "setup:env:generate": "node scripts/setup-env.js --generate",
    "validate:env": "node src/config/validateEnv.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test:seed": "node tests/seeds/index.js seed",
    "test:cleanup": "node tests/seeds/index.js cleanup",
    "test:reset": "node tests/seeds/index.js reset"
  },
  "engines": {
    "node": ">=18 <19"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.908.0",
    "africastalking": "^0.7.7",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "express-session": "^1.18.2",
    "express-slow-down": "^3.0.0",
    "form-data": "^4.0.4",
    "handlebars": "^4.7.8",
    "helmet": "^7.2.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^12.1.1",
    "memorystore": "^1.6.7",
    "morgan": "^1.10.1",
    "node-pg-migrate": "^8.0.3",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "redis": "^5.8.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.2",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.55.1",
    "audit": "^0.0.6",
    "axios": "^1.6.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "k6": "^0.0.0",
    "npm-audit-resolver": "^3.0.0-RC.0",
    "playwright": "^1.55.1",
    "supertest": "^7.1.4"
  }
}

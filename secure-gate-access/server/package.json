{
  "name": "secure-gate-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Secure Gate Access Control System - Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node --import ./load-env.js server.js",
    "dev": "nodemon --import ./load-env.js --inspect server.js",
    "test": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:coverage": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --coverage",
    "test:watch": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --watch",
    "test:unit": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/unit",
    "test:unit:coverage": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/unit --coverage",
    "test:unit:watch": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/unit --watch",
    "test:integration": "npm run test:integration:stable",
    "test:integration:stable": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --detectOpenHandles --testPathPattern=tests/integration --testPathIgnorePatterns='tests/integration/(app-route-mounting|intelligent-notification-basic|intelligent-notification-routes)\\.integration\\.test\\.js' --passWithNoTests",
    "test:integration:quarantine": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --detectOpenHandles --runTestsByPath tests/integration/app-route-mounting.integration.test.js tests/integration/intelligent-notification-basic.integration.test.js tests/integration/intelligent-notification-routes.integration.test.js --passWithNoTests",
    "test:integration:verbose": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --verbose --detectOpenHandles --testPathPattern=tests/integration --passWithNoTests",
    "test:integration:coverage": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/integration --passWithNoTests --coverage",
    "test:critical": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern='tests/integration/(auth-refresh|invite-lifecycle|estate-scoping|webhook-signature|notification-queue).integration.test.js' --passWithNoTests",
    "test:quarantine:verify": "node scripts/verify-quarantine-gating.js",
    "test:e2e": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/e2e --passWithNoTests",
    "test:e2e:coverage": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/e2e --passWithNoTests --coverage",
    "test:playwright": "node -e \"const {spawnSync}=require('node:child_process'); const args=process.argv.slice(1); const literal='Auth + CSRF smoke flow'; const escaped='Auth '+String.fromCharCode(92)+'+ CSRF smoke flow'; const isOption=(value)=>typeof value==='string' && value.startsWith('--'); for(let i=0;i<args.length;i+=1){ const arg=args[i]; if(arg==='--grep'){ const next=args[i+1]; if(typeof next==='undefined'){ continue; } if(next===literal){ args[i+1]=escaped; continue; } let end=i+1; while(end<args.length && isOption(args[end])===false){ end+=1; } const candidate=args.slice(i+1,end).join(' '); if(candidate===literal){ args.splice(i+1,end-(i+1),escaped); } continue; } if(typeof arg==='string' && arg.startsWith('--grep=')){ const value=arg.slice('--grep='.length); if(value===literal){ args[i]='--grep='+escaped; } } } const result=spawnSync('npx',['playwright','test','--config=tests/e2e/playwright.config.js',...args],{stdio:'inherit'}); process.exit(result.status ?? 1);\" --",
    "test:playwright:headed": "npx playwright test --config=tests/e2e/playwright.config.js --headed",
    "test:playwright:ui": "npx playwright test --config=tests/e2e/playwright.config.js --ui",
    "test:playwright:debug": "npx playwright test --config=tests/e2e/playwright.config.js --debug",
    "test:playwright:smoke:precheck": "npx playwright test --config=tests/e2e/playwright.config.js --project=chromium --grep \"Auth \\+ CSRF smoke flow\" --list",
    "test:playwright:smoke:serialized": "PW_SMOKE_PROFILE=1 npx playwright test --config=tests/e2e/playwright.config.js --project=chromium --grep \"Auth \\+ CSRF smoke flow\" --workers=1",
    "test:playwright:report": "npx playwright show-report",
    "test:playwright:install": "npx playwright install",
    "test:manual": "node tests/manual/execute-manual-tests.js",
    "test:manual:run": "node tests/manual/run-manual-tests.js",
    "test:manual:report": "open tests/results/manual-test-report.html",
    "test:performance": "node tests/performance/run-performance-tests.js",
    "test:performance:comprehensive": "node tests/performance/comprehensive-performance-test.js",
    "test:performance:monitor": "node tests/performance/monitor-dashboard.js",
    "test:performance:load": "k6 run tests/performance/load-test.js",
    "test:performance:stress": "k6 run tests/performance/stress-test.js",
    "test:performance:spike": "k6 run tests/performance/spike-test.js",
    "test:smoke": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/smoke",
    "test:regression": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/regression",
    "test:security": "node tests/security/run-security-audit.js",
    "test:security:regression": "NODE_ENV=test NODE_NO_WARNINGS=1 JWT_SECRET=test-jwt-secret-for-unit-tests-min-32-chars JWT_REFRESH_SECRET=test-jwt-refresh-secret-for-unit-tests-min-32-chars node --experimental-vm-modules node_modules/.bin/jest --runInBand --runTestsByPath tests/unit/setupRoutes.security.dynamic.test.js tests/unit/adminBulkEstateScope.dynamic.test.js tests/unit/mfaRoutes.test.js tests/unit/tokenService.test.js tests/unit/qrCodeController.regenerate.dynamic.test.js --config='{\"testEnvironment\":\"node\",\"transform\":{},\"moduleFileExtensions\":[\"js\",\"mjs\",\"json\"],\"clearMocks\":true,\"resetMocks\":true,\"testTimeout\":30000}' --forceExit",
    "test:security:audit": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/security --passWithNoTests",
    "test:security:vulnerability": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern='tests/security/(sql-injection|xss-prevention|static-analysis)\\.test\\.js' --passWithNoTests",
    "test:security:npm": "npm audit",
    "test:all": "npm run test:integration && npm run test:e2e && npm run test:manual && npm run test:performance && npm run test:security",
    "lint:error-handlers": "rg -n \"middleware/(errorHandler|enhancedErrorHandler)\" src server.js && exit 1 || exit 0",
    "audit:estate": "node scripts/audit-estate-assignments.js",
    "assign:estate": "node scripts/assign-estate-ids.js",
    "check:staging-parity": "node scripts/validate-staging-parity.js",
    "setup:env": "node scripts/setup-env.js",
    "setup:env:generate": "node scripts/setup-env.js --generate",
    "validate:env": "node src/config/validateEnv.js",
    "db:init": "node src/database/init.js",
    "db:migrate": "node --import ./load-env.js scripts/migrate.js",
    "db:migrate:id-numbers": "node scripts/migrate-id-numbers.js",
    "migrations:check-sequence": "node scripts/check-migration-sequence.js",
    "migrations:check-format": "node scripts/check-migration-format.js",
    "migrations:test-semantics": "node --test tests/unit/migrationScriptSemantics.test.cjs",
    "migrations:verify-p2-semantics": "npm run migrations:test-semantics && npm run migrations:check-format",
    "migrations:apply:ci": "node scripts/apply-migrations-ci.js",
    "db:seed": "node --import ./load-env.js scripts/seed.js",
    "create:guard": "node scripts/create-guard.js",
    "create:resident": "node scripts/create-resident.js",
    "retention:run": "node scripts/run-retention.js",
    "test:seed": "node tests/seeds/index.js seed",
    "test:cleanup": "node tests/seeds/index.js cleanup",
    "test:reset": "node tests/seeds/index.js reset",
    "test:mutation": "npx stryker run",
    "test:mutation:analyze": "node tests/mutation/mutation.utils.js",
    "test:contracts": "NODE_ENV=test NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=tests/contracts",
    "mfa:migrate": "node src/scripts/run-mfa-migration.js",
    "mfa:restore": "node src/scripts/restore-mfa-access.js",
    "mfa:verify": "node src/scripts/verify-mfa-implementation.js",
    "mfa:seed:guard-local": "node --import ./load-env.js scripts/seed-guard-mfa-local.js",
    "mfa:token:guard-local": "node --import ./load-env.js scripts/generate-guard-mfa-token-local.js",
    "test:abuse:regression": "NODE_ENV=test NODE_NO_WARNINGS=1 JWT_SECRET=test-jwt-secret-for-unit-tests-min-32-chars JWT_REFRESH_SECRET=test-jwt-refresh-secret-for-unit-tests-min-32-chars SETUP_SECRET=this-is-a-very-strong-setup-secret-12345 node --experimental-vm-modules node_modules/.bin/jest --runInBand --runTestsByPath tests/unit/visitorRoutes.abuse.dynamic.test.js tests/unit/visitorOtpController.abuse.dynamic.test.js tests/unit/setupRoutes.abuse.dynamic.test.js --config='{\"testEnvironment\":\"node\",\"transform\":{},\"moduleFileExtensions\":[\"js\",\"mjs\",\"json\"],\"clearMocks\":true,\"resetMocks\":true,\"testTimeout\":30000}' --forceExit"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.908.0",
    "@aws-sdk/client-secrets-manager": "^3.908.0",
    "@sentry/node": "^7.120.4",
    "@sentry/profiling-node": "^7.120.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "africastalking": "^0.7.9",
    "argon2": "^0.44.0",
    "axios-cookiejar-support": "^6.0.4",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-session": "^1.18.2",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.4",
    "handlebars": "^4.7.8",
    "helmet": "^7.2.0",
    "ical-generator": "^6.0.1",
    "ioredis": "^5.9.2",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.26",
    "mailgun.js": "^12.1.1",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.12",
    "pg": "^8.17.2",
    "qrcode": "^1.5.4",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tough-cookie": "^5.1.2",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "axios": "^1.13.5",
    "fast-check": "^4.5.3",
    "jest": "^29.7.0",
    "k6": "^0.0.0",
    "nodemon": "^3.1.11",
    "playwright": "^1.55.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "fast-xml-parser": "^5.5.9",
    "socket.io-parser": "^4.2.6",
    "picomatch": "^2.3.2",
    "minimatch": "^3.1.4",
    "express-slow-down": {
      "express-rate-limit": "^8.3.1"
    }
  }
}

# =============================================================================
# SECURE GATE ACCESS CONTROL SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values for your environment
# 
# IMPORTANT SECURITY NOTES:
# - Never commit .env files to version control
# - Use strong, unique secrets for production
# - Rotate secrets regularly
# - Use environment-specific values
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node.js Environment (development, test, production)
NODE_ENV=development

# Server Port (default: 5000, but 3001 recommended to avoid AirTunes conflict)
PORT=3001

# Application Name and Version
APP_NAME=Secure Gate Access Control System
APP_VERSION=1.0.0

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================

# Database Connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=secure_gate
PGUSER=secure_gate_user
PGPASSWORD=secure_gate_password

# Connection Pool Settings
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=5000

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# JWT Secrets (REQUIRED - Generate strong secrets for production)
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-32-chars-min
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-32-chars-min

# JWT Token Expiration (in seconds)
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-32-chars-min

# =============================================================================
# CORS & SECURITY
# =============================================================================

# CORS Origins (comma-separated list)
CLIENT_ORIGIN=http://localhost:3000
ADDITIONAL_ORIGINS=http://localhost:3001,https://yourdomain.com

# Security Headers
ENFORCE_HTTPS=false
SECURE_COOKIES=false
TRUST_PROXY=false

# =============================================================================
# RATE LIMITING
# =============================================================================

# General Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# OTP Rate Limiting
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Templates
EMAIL_FROM_NAME=Secure Gate System
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# =============================================================================
# SMS CONFIGURATION (Twilio)
# =============================================================================

# Twilio Account Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# REDIS CONFIGURATION (Optional - for production scaling)
# =============================================================================

# Redis URL for session storage and rate limiting
REDIS_URL=redis://localhost:6379

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log File Path
LOG_FILE_PATH=./logs

# Enable Request Logging
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Enable Debug Features (DISABLE IN PRODUCTION)
OTP_DEBUG_ECHO=false
ENABLE_DEBUG_ROUTES=false

# Database Query Logging
DB_QUERY_LOGGING=false

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# Allow HTTP in Production (ONLY for local development)
ALLOW_HTTP_IN_PRODUCTION=false

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API Version
API_VERSION=v1

# Request Size Limits
MAX_REQUEST_SIZE=10mb

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Health Check Endpoints
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Webhook URLs for notifications
WEBHOOK_URL=
NOTIFICATION_EMAIL=admin@yourdomain.com

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# File Upload Settings
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache TTL (in seconds)
CACHE_TTL=3600

# =============================================================================
# EXAMPLE PRODUCTION VALUES
# =============================================================================
# Uncomment and modify these for production deployment
#
# NODE_ENV=production
# PORT=3001
# PGHOST=your-production-db-host
# PGDATABASE=secure_gate_prod
# PGUSER=secure_gate_prod_user
# PGPASSWORD=your-super-secure-production-password
# JWT_SECRET=your-production-jwt-secret-64-chars-minimum
# JWT_REFRESH_SECRET=your-production-refresh-secret-64-chars-minimum
# SESSION_SECRET=your-production-session-secret-64-chars-minimum
# CLIENT_ORIGIN=https://yourdomain.com
# ENFORCE_HTTPS=true
# SECURE_COOKIES=true
# TRUST_PROXY=true
# REDIS_URL=redis://your-redis-host:6379
# SMTP_HOST=your-smtp-host
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# TWILIO_ACCOUNT_SID=your-production-twilio-sid
# TWILIO_AUTH_TOKEN=your-production-twilio-token
# LOG_LEVEL=warn
# OTP_DEBUG_ECHO=false
# ALLOW_HTTP_IN_PRODUCTION=false

# =============================================================================
# SECURE GATE ACCESS CONTROL SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local for development with your actual secrets
# 
# IMPORTANT SECURITY NOTES:
# - Never commit .env or .env.local files to version control
# - Use strong, unique secrets for each environment
# - Rotate secrets regularly (every 90 days minimum)
# - Use AWS Secrets Manager for staging/production
# - This file contains NO REAL SECRETS - only placeholders and documentation
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node.js Environment (development, test, staging, production)
NODE_ENV=development

# Server Port (3001 recommended to avoid conflicts)
PORT=3001

# Application Metadata
APP_NAME=Secure Gate Access Control System
APP_VERSION=1.0.0

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================

# Database Connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=secure_gate
PGUSER=secure_gate_user
PGPASSWORD=CHANGEME_STRONG_DATABASE_PASSWORD

# Test Database (for NODE_ENV=test)
TEST_PGDATABASE=secure_gate_test

# Connection Pool Settings (Performance Tuning)
PGPOOL_MAX=20
PGPOOL_MIN=2
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=5000
PGPOOL_ACQUIRE_TIMEOUT=10000
PGPOOL_KEEPALIVE_DELAY=10000
PGPOOL_MAX_RETRY=5
PGPOOL_RETRY_DELAY=2000
PGPOOL_MAX_RETRY_DELAY=30000
PGPOOL_HEALTH_INTERVAL=30000

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# JWT Secrets (CRITICAL - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))")
# NEVER use these placeholder values in any environment
JWT_SECRET=CHANGEME_GENERATE_64_BYTE_CRYPTOGRAPHIC_SECRET
JWT_REFRESH_SECRET=CHANGEME_GENERATE_64_BYTE_CRYPTOGRAPHIC_SECRET
SESSION_SECRET=CHANGEME_GENERATE_64_BYTE_CRYPTOGRAPHIC_SECRET

# JWT Token Expiration
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY_DAYS=7

# =============================================================================
# CORS & FRONTEND CONFIGURATION
# =============================================================================

# CORS Origins (comma-separated list)
# Development: Use localhost and 127.0.0.1 variants
# Production: Use actual frontend domain(s)
CLIENT_ORIGIN=http://localhost:3000
ADDITIONAL_ORIGINS=http://127.0.0.1:3000,http://localhost:3002

# Frontend URLs
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3001
SITE_NAME=Secure Gate Access

# =============================================================================
# SECURITY HEADERS & TRANSPORT
# =============================================================================

# Transport Layer Security (Set to true in production)
ENFORCE_HTTPS=false
SECURE_COOKIES=false
TRUST_PROXY=false

# HSTS Configuration
HSTS_MAX_AGE=63072000

# HPKP (HTTP Public Key Pinning) - Advanced, optional
ENABLE_HPKP=false
HPKP_PINS=
HPKP_MAX_AGE=300

# =============================================================================
# RATE LIMITING
# =============================================================================

# General API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication Rate Limiting (more restrictive)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# OTP Rate Limiting (very restrictive)
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3

# =============================================================================
# REDIS CONFIGURATION (Optional - for rate limiting & sessions)
# =============================================================================

# Redis Connection
# If not set, will use in-memory stores (not suitable for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email Provider Selection: 'mailgun' or 'smtp'
EMAIL_PROVIDER=mailgun

# Mailgun Configuration (Recommended)
MAILGUN_API_KEY=CHANGEME_YOUR_MAILGUN_API_KEY
MAILGUN_DOMAIN=CHANGEME_YOUR_MAILGUN_DOMAIN
MAILGUN_BASE_URL=https://api.mailgun.net
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Secure Gate Access

# SMTP Configuration (Alternative/Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=CHANGEME_YOUR_SMTP_PASSWORD
SMTP_FROM_NAME=Secure Gate System

# =============================================================================
# SMS CONFIGURATION
# =============================================================================

# SMS Provider Selection: 'africastalking' or 'twilio'
SMS_PROVIDER=africastalking

# Africa's Talking Configuration (Recommended for Kenya/Africa)
AT_USERNAME=CHANGEME_YOUR_AT_USERNAME
AT_API_KEY=CHANGEME_YOUR_AT_API_KEY
AT_SENDER_ID=

# Twilio Configuration (Alternative)
TWILIO_ACCOUNT_SID=CHANGEME_YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=CHANGEME_YOUR_TWILIO_TOKEN
TWILIO_FROM_NUMBER=+1234567890

# =============================================================================
# DATA ENCRYPTION CONFIGURATION
# =============================================================================

# Encryption Method: 'aws-kms', 'vault', or 'local' (dev only)
# CRITICAL: Use 'aws-kms' or 'vault' in production, NEVER 'local'
ENCRYPTION_METHOD=local

# AWS KMS Configuration (Recommended for production)
AWS_KMS_KEY_ID=
AWS_REGION=af-south-1

# HashiCorp Vault Configuration (Alternative for Docker/HA)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_ENCRYPTION_KEY_PATH=secret/data/encryption-keys

# Local Encryption Key (DEVELOPMENT ONLY)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGEME_GENERATE_32_BYTE_KEY_FOR_DEV_ONLY

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log File Configuration
LOG_FILE_PATH=./logs

# Enable Request Logging
ENABLE_REQUEST_LOGGING=true

# Monitoring
ENABLE_MONITORING=true
MONITORING_INTERVAL=30000

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Debug Features (DISABLE IN PRODUCTION)
DEBUG=false
OTP_DEBUG_ECHO=false
ENABLE_DEBUG_ROUTES=false

# Database Query Logging
DB_QUERY_LOGGING=false

# SQLite Fallback (Development only)
USE_SQLITE=false
SQLITE_PATH=./dev.db

# =============================================================================
# OTP & SECURITY FEATURES
# =============================================================================

# OTP Configuration
OTP_TTL_MINUTES=15
ALERT_ON_OTP_FAILS=false

# Bcrypt Rounds (Higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# CRON JOBS & BACKGROUND TASKS
# =============================================================================

# Cron Job Configuration
CRON_INVITE_LIFECYCLE=0 * * * *
CRON_VISITOR_EXPIRE=0 2 * * *

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API Version
API_VERSION=v1

# API Base URL
API_BASE_URL=http://localhost:3001

# Request Size Limits
MAX_REQUEST_SIZE=10mb

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Health Check Endpoints
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# =============================================================================
# NOTIFICATION & SERVICES CONFIGURATION
# =============================================================================

# Service Feature Flags (Enable/disable entire services)
ENABLE_WEBHOOKS=false
ENABLE_AUTOMATIONS=false
ENABLE_EXTERNAL_NOTIFICATIONS=true

# Webhook Configuration
WEBHOOK_URL=
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_MS=5000

# Notification Toggles
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
NOTIFICATION_EMAIL=admin@yourdomain.com

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# File Upload Settings
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache TTL (in seconds)
CACHE_TTL=3600
CACHE_DEFAULT_TTL=300
CACHE_VISITOR_LIST_TTL=300
CACHE_USER_PROFILE_TTL=900
CACHE_PUBLIC_DATA_TTL=3600
CACHE_ADMIN_STATS_TTL=120

# =============================================================================
# PRODUCTION OVERRIDES (Uncomment for production)
# =============================================================================

# NODE_ENV=production
# PORT=3001
# ENFORCE_HTTPS=true
# SECURE_COOKIES=true
# TRUST_PROXY=true
# OTP_DEBUG_ECHO=false
# DEBUG=false
# ENABLE_DEBUG_ROUTES=false
# LOG_LEVEL=warn
# DB_QUERY_LOGGING=false
# ENCRYPTION_METHOD=aws-kms
# ENABLE_WEBHOOKS=true
# ENABLE_AUTOMATIONS=true
# ENABLE_EXTERNAL_NOTIFICATIONS=true

# =============================================================================
# AWS SECRETS MANAGER INTEGRATION (Production/Staging)
# =============================================================================

# Secrets Manager Configuration
# When using AWS Secrets Manager, specify secret names (not actual values)
# SECRETS_PREFIX=secure-gate/production
# SECRETS_CACHE_TTL=300000

# Secret Names (for reference)
# DB_SECRET_NAME=secure-gate/production/db/credentials
# JWT_SECRET_NAME=secure-gate/production/jwt/secrets
# REDIS_SECRET_NAME=secure-gate/production/redis/password
# SESSION_SECRET_NAME=secure-gate/production/session/secret
# API_KEYS_SECRET_NAME=secure-gate/production/api-keys

# =============================================================================
# SECURITY VALIDATION CHECKLIST
# =============================================================================

# Before deploying to production, ensure:
# ✅ All CHANGEME_ placeholders replaced with real secrets
# ✅ JWT/Session secrets are cryptographically strong (64+ bytes)
# ✅ Database password is strong and unique
# ✅ ENFORCE_HTTPS=true
# ✅ SECURE_COOKIES=true
# ✅ TRUST_PROXY=true (if behind load balancer)
# ✅ OTP_DEBUG_ECHO=false
# ✅ DEBUG=false, ENABLE_DEBUG_ROUTES=false
# ✅ Mailgun/AT credentials are production keys (not sandbox)
# ✅ ENCRYPTION_METHOD=aws-kms (not local)
# ✅ CLIENT_ORIGIN set to production frontend domain
# ✅ Redis configured for production (not in-memory)
# ✅ All secrets rotated from development values

# =============================================================================
# GENERATE SECRETS COMMAND
# =============================================================================

# Run this command to generate cryptographically secure secrets:
# node -e "console.log('JWT_SECRET=' + require('crypto').randomBytes(64).toString('base64url')); console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(64).toString('base64url')); console.log('SESSION_SECRET=' + require('crypto').randomBytes(64).toString('base64url')); console.log('ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('base64'));"

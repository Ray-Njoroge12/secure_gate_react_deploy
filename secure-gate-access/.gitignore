# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# Environment Files (CRITICAL - Phase A0)
# Never commit files with secrets
.env
.env.local
.env.test
.env.staging
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Exception: Allow template/example files without secrets
!.env.development
!.env.example
!.env.staging.example
!.env.production.template

# SECURITY: Explicitly block production env files with secrets
server/.env
server/.env.test
server/.env.staging
server/.env.production
server/.env.local

# Node modules
node_modules/
**/node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/


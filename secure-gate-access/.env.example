# ==============================================================================
# SECURE GATE ACCESS - UNIFIED ENVIRONMENT TEMPLATE
# ==============================================================================
# This is the single source of truth for environment variables.
# 1. Copy this file to .env
# 2. Fill in your local values
# 3. For Production/Staging, these are pulled from AWS Secrets Manager
# ==============================================================================

# ------------------------------------------------------------------------------
# 🟢 CORE SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 🔵 DATABASE (POSTGRES)
# ------------------------------------------------------------------------------
# Individual parameters (Preferred)
PGHOST=localhost
PGPORT=5432
PGDATABASE=secure_gate
PGUSER=postgres
PGPASSWORD=postgres

# Full Connection URL (Overrides individual parameters if provided)
DATABASE_URL=postgresql://user:password@localhost:5432/secure_gate

# Pool Configuration
PGPOOL_MIN=2
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 🔴 SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Required for and development (Generate strong keys for production!)
JWT_SECRET=development_only_secret_change_me_in_production_32_chars_plus
JWT_REFRESH_SECRET=development_only_refresh_secret_change_me_in_production
SESSION_SECRET=development_only_session_secret_change_me_in_production
ENCRYPTION_KEY=development_only_encryption_key_64_hex_chars_total_length_x

# CORS Settings
CLIENT_ORIGIN=http://localhost:3000
ADDITIONAL_ORIGINS=http://127.0.0.1:3000

# Cookies & Proxy (Production only)
SECURE_COOKIES=false
TRUST_PROXY=false
ENFORCE_HTTPS=false

# CSRF & Rate Limiting (Development overrides)
DISABLE_CSRF=true
ENABLE_RATE_LIMIT=false

# ------------------------------------------------------------------------------
# 🟡 EXTERNAL SERVICES
# ------------------------------------------------------------------------------
# Email Provider: 'mailgun' | 'smtp' | 'console'
EMAIL_PROVIDER=console
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# SMS Provider: 'africastalking' | 'twilio' | 'console'
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 🟠 CLOUD & DEPLOYMENT (AWS)
# ------------------------------------------------------------------------------
# When USE_AWS_SECRETS=true, the server fetches secrets from AWS Secrets Manager.
# Pattern: <SECRETS_PREFIX>/<VARIABLE_NAME>
# Example: secure-gate/production/DATABASE_URL
USE_AWS_SECRETS=false
AWS_REGION=us-east-1
SECRETS_PREFIX=secure-gate/development

# ------------------------------------------------------------------------------
# 🟣 MONITORING (SENTRY)
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Frontend variables must be prefixed with REACT_APP_
REACT_APP_SENTRY_DSN=
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

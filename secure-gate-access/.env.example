# =============================================================================
# SECURE GATE ACCESS CONTROL SYSTEM - PROJECT-LEVEL CONFIGURATION
# =============================================================================
# This file is for Docker Compose and infrastructure-level environment variables
# Backend-specific config is in: server/env.example
# Frontend-specific config is in: client/env.example
#
# SECURITY: This is a sanitized example file with NO REAL SECRETS
# Copy to .env.local and replace all CHANGEME_ placeholders
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL - Docker/RDS)
# =============================================================================

POSTGRES_DB=secure_gate
POSTGRES_USER=secure_gate_user
POSTGRES_PASSWORD=CHANGEME_STRONG_DATABASE_PASSWORD

# Database Connection String (for Docker Compose)
DATABASE_URL=postgresql://secure_gate_user:CHANGEME_PASSWORD@postgres:5432/secure_gate

# =============================================================================
# REDIS CONFIGURATION (Docker/ElastiCache)
# =============================================================================

REDIS_PASSWORD=CHANGEME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGEME_PASSWORD@redis:6379

# =============================================================================
# JWT & SESSION SECRETS (Must match server/.env)
# =============================================================================

JWT_SECRET=CHANGEME_GENERATE_64_BYTE_SECRET
JWT_REFRESH_SECRET=CHANGEME_GENERATE_64_BYTE_SECRET
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

SESSION_SECRET=CHANGEME_GENERATE_64_BYTE_SECRET

# =============================================================================
# APPLICATION URLS
# =============================================================================

# Frontend URL (production domain)
FRONTEND_URL=https://yourdomain.com

# Backend API URL (for frontend to connect)
REACT_APP_API_URL=https://api.yourdomain.com
REACT_APP_ENVIRONMENT=production
REACT_APP_VERSION=1.0.0

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=CHANGEME_SMTP_APP_PASSWORD
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX_REQUESTS=3

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

LOG_LEVEL=info
MONITORING_INTERVAL_MS=60000

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=CHANGEME_GENERATE_ENCRYPTION_KEY

# =============================================================================
# GRAFANA MONITORING (Optional)
# =============================================================================

GRAFANA_PASSWORD=CHANGEME_GRAFANA_PASSWORD
GRAFANA_PORT=3001

# =============================================================================
# SSL CONFIGURATION (Nginx/Load Balancer)
# =============================================================================

SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_ENABLED=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=30

# =============================================================================
# AWS CONFIGURATION (Production)
# =============================================================================

AWS_REGION=af-south-1

# AWS Secrets Manager (Production/Staging)
SECRETS_PREFIX=secure-gate/production
SECRETS_CACHE_TTL=300000

# Secret Names (not actual secrets)
DB_SECRET_NAME=secure-gate/production/db/credentials
JWT_SECRET_NAME=secure-gate/production/jwt/secrets
REDIS_SECRET_NAME=secure-gate/production/redis/password
SESSION_SECRET_NAME=secure-gate/production/session/secret
API_KEYS_SECRET_NAME=secure-gate/production/api-keys

# =============================================================================
# DEVELOPMENT FLAGS (Disable in production)
# =============================================================================

DEBUG=false
OTP_DEBUG_ECHO=false
ENABLE_DEBUG_ROUTES=false

# =============================================================================
# NGINX CONFIGURATION (If using Nginx reverse proxy)
# =============================================================================

NGINX_PROXY_PORT=80
NGINX_SSL_PORT=443

# =============================================================================
# DOCKER COMPOSE PORTS
# =============================================================================

# Frontend port
CLIENT_PORT=3000

# Backend port
SERVER_PORT=3001

# PostgreSQL port
POSTGRES_PORT=5432

# Redis port
REDIS_PORT=6379

# =============================================================================
# TIMEZONE & LOCALE
# =============================================================================

TIMEZONE=Africa/Nairobi
LOCALE=en-KE
CURRENCY=KES

# =============================================================================
# GENERATE SECRETS COMMAND
# =============================================================================

# Run this to generate strong secrets:
# node -e "console.log('JWT_SECRET=' + require('crypto').randomBytes(64).toString('base64url')); console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(64).toString('base64url')); console.log('SESSION_SECRET=' + require('crypto').randomBytes(64).toString('base64url')); console.log('POSTGRES_PASSWORD=' + require('crypto').randomBytes(32).toString('base64url')); console.log('REDIS_PASSWORD=' + require('crypto').randomBytes(32).toString('base64url'));"

# =============================================================================
# SECURE GATE - DOCKER COMPOSE CONFIGURATION TEMPLATE
# =============================================================================
# This file provides variable substitution for docker-compose.yml
# Copy to .env and replace all CHANGEME_ placeholders
#
# Backend-specific config: server/.env.example
# Frontend-specific config: client/.env.example
# Staging config: .env.staging.example
# =============================================================================

# =============================================================================
# DATABASE (used by docker-compose postgres service)
# =============================================================================
POSTGRES_DB=secure_gate
POSTGRES_USER=secure_gate_user
POSTGRES_PASSWORD=CHANGEME_STRONG_DATABASE_PASSWORD
POSTGRES_HOST_PORT=5432
POSTGRES_IMAGE=postgres:15

# =============================================================================
# SECRETS (passed to backend container by docker-compose)
# =============================================================================
JWT_SECRET=CHANGEME_GENERATE_64_BYTE_SECRET
JWT_REFRESH_SECRET=CHANGEME_GENERATE_64_BYTE_SECRET

# =============================================================================
# GENERATE SECRETS COMMAND
# =============================================================================
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"

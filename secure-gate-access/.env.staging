# Staging Environment Configuration
# This file is used for local staging deployments and validation
# DO NOT use in production - generate secure secrets for production!

# Node Environment
NODE_ENV=staging

# Server Configuration
PORT=5001

# Database Configuration
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=staging_password_change_me
PGDATABASE=secure_gate_staging

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=staging-jwt-secret-min-32-chars-change-in-production-environment
JWT_REFRESH_SECRET=staging-refresh-secret-min-32-chars-change-in-production

# Email Configuration
EMAIL_VERIFICATION_REQUIRED=false

# Logging and Monitoring
LOG_LEVEL=info
ENABLE_CORRELATION_ID=true
ENABLE_ENHANCED_HEALTH=true
ENABLE_METRICS=true
ENABLE_ERROR_MONITORING=true

# Database Migrations
AUTO_RUN_MIGRATIONS=true

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CLIENT_ORIGIN=http://localhost:3001
STAGING_CLIENT_ORIGIN=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=staging-session-secret-min-32-chars-change-in-production
SESSION_MAX_AGE=86400000

# Feature Flags
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false

# Observability Features (P1 Pack)
ENABLE_REQUEST_CORRELATION=true
ENABLE_DISTRIBUTED_TRACING=true
ENABLE_HEALTH_MONITORING=true
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_METRICS=true

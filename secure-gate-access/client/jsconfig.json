{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "*": ["*"],
      "utils/*": ["utils/*"],
      "components/*": ["components/*"],
      "hooks/*": ["hooks/*"],
      "contexts/*": ["contexts/*"],
      "pages/*": ["pages/*"],
      "services/*": ["services/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}



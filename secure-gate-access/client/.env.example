# ============================================================
# REQUIRED
# ============================================================
REACT_APP_API_URL=http://localhost:3001        # Backend base URL

# ============================================================
# OPTIONAL — defaults used if not set
# ============================================================
REACT_APP_WS_URL=                              # WebSocket URL (derived from REACT_APP_API_URL if empty)
REACT_APP_VAPID_PUBLIC_KEY=                    # Web Push VAPID public key (from server npm run generate:vapid)
REACT_APP_VERSION=1.0.0                        # App version string shown in UI

# ============================================================
# OPTIONAL — Sentry error/performance monitoring
# ============================================================
REACT_APP_SENTRY_DSN=                          # Sentry DSN (disabled if empty)
REACT_APP_SENTRY_ENVIRONMENT=development       # Sentry environment name
REACT_APP_SENTRY_RELEASE=                      # App release tag/version
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1        # Performance traces sample rate (0.0-1.0)

# ============================================================
# DEV/TEST ONLY (do not set in production)
# ============================================================
# REACT_APP_ENABLE_SW_DEV=true                 # Enable service worker while not in production
# REACT_APP_SENTRY_DEBUG=true                  # Enable verbose Sentry client debug logs
# REACT_APP_DEFAULT_ESTATE_ID=1                # Default estate id used by registration fallback
# REACT_APP_DEFAULT_ESTATE_NAME=Default Estate # Default estate name used by registration fallback
# REACT_APP_TEST_MODE=true                     # Force QR scan test mode outside NODE_ENV=test
# REACT_APP_MOCK_API=true                      # Enable mock API responses
# REACT_APP_DEBUG_AUTH=true                    # Enable auth debug logging

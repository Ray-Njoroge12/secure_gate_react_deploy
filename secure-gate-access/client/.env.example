# =============================================================================
# SECURE GATE - CLIENT ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to .env for local development
# For production, set these in Netlify Dashboard → Site Settings → Environment Variables
# =============================================================================

# API Configuration (REQUIRED)
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

# App Version
REACT_APP_VERSION=1.0.0

# Error Tracking (Optional - Sentry)
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn

# Push Notifications (Optional - VAPID key from server)
# REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key

# =============================================================================
# PRODUCTION VALUES (Set in Netlify Dashboard)
# =============================================================================
# REACT_APP_API_URL=https://secure-gate-api.onrender.com
# REACT_APP_WS_URL=wss://secure-gate-api.onrender.com
# REACT_APP_VERSION=1.0.0
# GENERATE_SOURCEMAP=false
# =============================================================================

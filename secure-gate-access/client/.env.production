# Production Environment Configuration
# Secure Gate Access Control System v1.0.0

# API Configuration
# Backend hosted on Render
REACT_APP_API_URL=https://secure-gate-api.onrender.com
REACT_APP_ENVIRONMENT=production
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_DEBUG_MODE=false
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_PWA=true

# Security Configuration
REACT_APP_SECURE_COOKIES=true
REACT_APP_CORS_ORIGIN=https://ephemeral-malasada-49b47b.netlify.app

# Performance Configuration
REACT_APP_ENABLE_CACHING=true
REACT_APP_CACHE_VERSION=1.0.0

# Monitoring Configuration
REACT_APP_ENABLE_MONITORING=true
REACT_APP_SENTRY_DSN=

# Build Configuration
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# PWA Configuration
REACT_APP_PWA_NAME="Secure Gate Access"
REACT_APP_PWA_SHORT_NAME="SecureGate"
REACT_APP_PWA_DESCRIPTION="Secure Gate Access Control System"
REACT_APP_PWA_THEME_COLOR="#2563eb"
REACT_APP_PWA_BACKGROUND_COLOR="#ffffff"

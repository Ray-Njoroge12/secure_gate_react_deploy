# =============================================================================
# SECURE GATE - CLIENT PRODUCTION ENVIRONMENT
# =============================================================================
# Note: In Netlify deployment, API calls are proxied via netlify.toml redirects
# Set REACT_APP_API_URL in Netlify Dashboard for overrides
# =============================================================================

# API Configuration
REACT_APP_API_URL=https://secure-gate-api.onrender.com
REACT_APP_WS_URL=wss://secure-gate-api.onrender.com

# App Version
REACT_APP_VERSION=1.0.0

# Error Monitoring - Sentry (Optional)
# REACT_APP_SENTRY_DSN=your-sentry-dsn

# Disable source maps for production
GENERATE_SOURCEMAP=false

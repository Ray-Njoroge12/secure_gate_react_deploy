{
  "name": "secure-gate-client",
  "version": "1.0.0",
  "private": true,
  "proxy": "http://localhost:3001",
  "scripts": {
    "start": "react-scripts start",
    "dev:network": "cross-env HOST=0.0.0.0 DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "build": "react-scripts build",
    "build:fast": "cross-env GENERATE_SOURCEMAP=false CI=true INLINE_RUNTIME_CHUNK=false IMAGE_INLINE_SIZE_LIMIT=0 TSC_COMPILE_ON_ERROR=true react-scripts build",
    "build:production": "cross-env GENERATE_SOURCEMAP=false CI=true INLINE_RUNTIME_CHUNK=false IMAGE_INLINE_SIZE_LIMIT=0 DISABLE_ESLINT_PLUGIN=true TSC_COMPILE_ON_ERROR=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "analyze": "npm run build:fast && npx source-map-explorer 'build/static/js/*.js'",
    "clean:cache": "rimraf node_modules/.cache build",
    "test:performance": "npm run build:fast && node scripts/run-performance-tests.js",
    "test:performance:watch": "npm run build:fast && node scripts/run-performance-tests.js --watch",
    "test:performance:report": "npm run build:fast && node scripts/run-performance-tests.js --report",
    "lighthouse": "npm run build:fast && npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --chrome-flags='--headless'",
    "test:e2e": "node src/__tests__/e2e/run-e2e-tests.js",
    "test:e2e:ci": "node src/__tests__/e2e/run-e2e-tests.js --headless",
    "test:e2e:verbose": "node src/__tests__/e2e/run-e2e-tests.js --verbose",
    "test:e2e:keep-alive": "node src/__tests__/e2e/run-e2e-tests.js --keep-alive",
    "test:e2e:debug": "node src/__tests__/e2e/run-e2e-tests.js",
    "test:e2e:manual": "npm test -- --testPathPattern=comprehensive-e2e.test.js --testTimeout=60000 --watchAll=false",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:report": "playwright show-report",
    "test:a11y": "react-scripts test --testPathPattern='a11y' --watchAll=false"
  },
  "dependencies": {
    "@sentry/react": "^7.120.4",
    "@sentry/tracing": "^7.120.4",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "html2canvas": "^1.4.1",
    "intersection-observer": "^0.12.2",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.2",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.12.26",
    "lucide-react": "^0.544.0",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "^5.0.1",
    "recharts": "^3.4.1",
    "resize-observer-polyfill": "^1.5.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "@svgr/plugin-svgo": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "css-select": "^5.1.0",
    "nth-check": "^2.1.1",
    "svgo": "^3.1.0",
    "tmp": "^0.2.5",
    "dompurify": "^3.3.1",
    "cookie": "^1.1.1"
  },
  "browserslist": {
    "production": [
      "> 1%",
      "last 2 versions",
      "not dead",
      "Chrome >= 60",
      "Firefox >= 60",
      "Safari >= 12",
      "Edge >= 79",
      "iOS >= 12",
      "Android >= 8",
      "not IE 11",
      "not IE_Mob 11",
      "not OperaMini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/scripts/**/*"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 65,
        "functions": 70,
        "lines": 70
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|fast-check|uuid)/)"
    ]
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@craco/craco": "^5.9.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "fast-check": "^4.5.3",
    "jest-axe": "^10.0.0",
    "msw": "^1.3.2",
    "postcss": "^8.5.6",
    "puppeteer": "^24.29.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.17",
    "web-vitals": "^3.5.0",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}

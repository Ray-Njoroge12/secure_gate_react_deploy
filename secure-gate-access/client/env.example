# =============================================================================
# SECURE GATE ACCESS CONTROL SYSTEM - FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values for your environment
# 
# IMPORTANT SECURITY NOTES:
# - Never commit .env files to version control
# - All React environment variables must start with REACT_APP_
# - These variables are exposed to the browser - do not include secrets
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Environment (development, test, production)
REACT_APP_ENVIRONMENT=development

# Application Name and Version
REACT_APP_NAME=Secure Gate Access Control System
REACT_APP_VERSION=1.0.0

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API URL
# Development: Use proxy in package.json (http://localhost:5000)
# Production: Use your production API URL
REACT_APP_API_URL=

# API Version
REACT_APP_API_VERSION=v1

# API Timeout (in milliseconds)
REACT_APP_API_TIMEOUT=10000

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Token Storage Method (localStorage, sessionStorage, memory)
REACT_APP_TOKEN_STORAGE=localStorage

# Token Refresh Interval (in milliseconds)
REACT_APP_TOKEN_REFRESH_INTERVAL=300000

# Remember Me Duration (in days)
REACT_APP_REMEMBER_ME_DAYS=30

# =============================================================================
# UI CONFIGURATION
# =============================================================================

# Application Title
REACT_APP_TITLE=Secure Gate Access Control

# Application Description
REACT_APP_DESCRIPTION=Secure access control system for residential buildings

# Default Language
REACT_APP_DEFAULT_LANGUAGE=en

# Theme Configuration
REACT_APP_DEFAULT_THEME=light
REACT_APP_ENABLE_DARK_MODE=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable Debug Mode (shows additional logging and tools)
REACT_APP_DEBUG_MODE=false

# Enable Development Tools (React DevTools, etc.)
REACT_APP_DEV_TOOLS=true

# Enable Service Worker
REACT_APP_ENABLE_SERVICE_WORKER=false

# Enable PWA Features
REACT_APP_ENABLE_PWA=false

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Enable Browser Notifications
REACT_APP_ENABLE_NOTIFICATIONS=true

# Notification Permission Request
REACT_APP_REQUEST_NOTIFICATION_PERMISSION=true

# =============================================================================
# QR CODE CONFIGURATION
# =============================================================================

# QR Code Size (in pixels)
REACT_APP_QR_CODE_SIZE=200

# QR Code Error Correction Level (L, M, Q, H)
REACT_APP_QR_ERROR_CORRECTION_LEVEL=M

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum File Size (in bytes)
REACT_APP_MAX_FILE_SIZE=5242880

# Allowed File Types (comma-separated)
REACT_APP_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache TTL (in milliseconds)
REACT_APP_CACHE_TTL=3600000

# Enable Offline Support
REACT_APP_ENABLE_OFFLINE=false

# =============================================================================
# ANALYTICS CONFIGURATION (Optional)
# =============================================================================

# Google Analytics Tracking ID
REACT_APP_GA_TRACKING_ID=

# Enable Analytics
REACT_APP_ENABLE_ANALYTICS=false

# =============================================================================
# ERROR REPORTING CONFIGURATION (Optional)
# =============================================================================

# Sentry DSN for error reporting
REACT_APP_SENTRY_DSN=

# Enable Error Reporting
REACT_APP_ENABLE_ERROR_REPORTING=false

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable Mock Data (for development without backend)
REACT_APP_USE_MOCK_DATA=false

# Mock API Delay (in milliseconds)
REACT_APP_MOCK_API_DELAY=500

# Enable Redux DevTools
REACT_APP_REDUX_DEVTOOLS=true

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# Enable Source Maps in Production
REACT_APP_GENERATE_SOURCEMAP=false

# Enable Bundle Analyzer
REACT_APP_ANALYZE_BUNDLE=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Content Security Policy
REACT_APP_CSP_ENABLED=true

# Enable HTTPS Only
REACT_APP_HTTPS_ONLY=false

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Enable Code Splitting
REACT_APP_ENABLE_CODE_SPLITTING=true

# Enable Lazy Loading
REACT_APP_ENABLE_LAZY_LOADING=true

# =============================================================================
# EXAMPLE PRODUCTION VALUES
# =============================================================================
# Uncomment and modify these for production deployment
#
# REACT_APP_ENVIRONMENT=production
# REACT_APP_API_URL=https://api.yourdomain.com
# REACT_APP_DEBUG_MODE=false
# REACT_APP_DEV_TOOLS=false
# REACT_APP_ENABLE_SERVICE_WORKER=true
# REACT_APP_ENABLE_PWA=true
# REACT_APP_ENABLE_NOTIFICATIONS=true
# REACT_APP_ENABLE_OFFLINE=true
# REACT_APP_ENABLE_ANALYTICS=true
# REACT_APP_GA_TRACKING_ID=GA-XXXXXXXXX-X
# REACT_APP_ENABLE_ERROR_REPORTING=true
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn
# REACT_APP_USE_MOCK_DATA=false
# REACT_APP_REDUX_DEVTOOLS=false
# REACT_APP_GENERATE_SOURCEMAP=false
# REACT_APP_CSP_ENABLED=true
# REACT_APP_HTTPS_ONLY=true

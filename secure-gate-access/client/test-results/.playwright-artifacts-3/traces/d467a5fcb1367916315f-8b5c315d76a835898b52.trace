-green-900:not([class*=\"dark:text-\"]) {\n  color: #86efac !important; /* green-300 */\n}\n\n[data-theme=\"dark\"] .text-green-800:not([class*=\"dark:text-\"]),\n.dark .text-green-800:not([class*=\"dark:text-\"]) {\n  color: #86efac !important; /* green-300 */\n}\n\n[data-theme=\"dark\"] .text-green-700:not([class*=\"dark:text-\"]),\n.dark .text-green-700:not([class*=\"dark:text-\"]) {\n  color: #86efac !important; /* green-300 */\n}\n\n[data-theme=\"dark\"] .text-red-900:not([class*=\"dark:text-\"]),\n.dark .text-red-900:not([class*=\"dark:text-\"]) {\n  color: #fca5a5 !important; /* red-300 */\n}\n\n[data-theme=\"dark\"] .text-red-800:not([class*=\"dark:text-\"]),\n.dark .text-red-800:not([class*=\"dark:text-\"]) {\n  color: #fca5a5 !important; /* red-300 */\n}\n\n[data-theme=\"dark\"] .text-red-700:not([class*=\"dark:text-\"]),\n.dark .text-red-700:not([class*=\"dark:text-\"]) {\n  color: #fca5a5 !important; /* red-300 */\n}\n\n[data-theme=\"dark\"] .text-yellow-900:not([class*=\"dark:text-\"]),\n.dark .text-yellow-900:not([class*=\"dark:text-\"]) {\n  color: #fcd34d !important; /* amber-300 */\n}\n\n[data-theme=\"dark\"] .text-yellow-800:not([class*=\"dark:text-\"]),\n.dark .text-yellow-800:not([class*=\"dark:text-\"]) {\n  color: #fcd34d !important; /* amber-300 */\n}\n\n/* --- Semantic Border Colors in Dark Mode --- */\n[data-theme=\"dark\"] .border-blue-200:not([class*=\"dark:border-\"]),\n.dark .border-blue-200:not([class*=\"dark:border-\"]) {\n  border-color: #1e40af !important; /* blue-800 */\n}\n\n[data-theme=\"dark\"] .border-green-200:not([class*=\"dark:border-\"]),\n.dark .border-green-200:not([class*=\"dark:border-\"]) {\n  border-color: #065f46 !important; /* green-800 */\n}\n\n[data-theme=\"dark\"] .border-red-200:not([class*=\"dark:border-\"]),\n.dark .border-red-200:not([class*=\"dark:border-\"]) {\n  border-color: #991b1b !important; /* red-800 */\n}\n\n[data-theme=\"dark\"] .border-yellow-200:not([class*=\"dark:border-\"]),\n.dark .border-yellow-200:not([class*=\"dark:border-\"]) {\n  border-color: #92400e !important; /* amber-800 */\n}\n\n[data-theme=\"dark\"] .border-amber-200:not([class*=\"dark:border-\"]),\n.dark .border-amber-200:not([class*=\"dark:border-\"]) {\n  border-color: #92400e !important; /* amber-800 */\n}\n\n/* --- Table Overrides for Dark Mode --- */\n[data-theme=\"dark\"] table thead,\n.dark table thead {\n  background-color: #1e293b; /* slate-800 */\n}\n\n[data-theme=\"dark\"] table tbody tr:hover,\n.dark table tbody tr:hover {\n  background-color: #334155; /* slate-700 */\n}\n\n[data-theme=\"dark\"] table th,\n.dark table th {\n  color: #e2e8f0; /* slate-200 */\n  border-color: #334155; /* slate-700 */\n}\n\n[data-theme=\"dark\"] table td,\n.dark table td {\n  color: #cbd5e1; /* slate-300 */\n  border-color: #334155; /* slate-700 */\n}\n\n/* --- Shadow Normalization for Dark Mode --- */\n[data-theme=\"dark\"] .shadow-sm,\n.dark .shadow-sm {\n  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.3) !important;\n}\n\n[data-theme=\"dark\"] .shadow,\n[data-theme=\"dark\"] .shadow-md,\n.dark .shadow,\n.dark .shadow-md {\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3) !important;\n}\n\n[data-theme=\"dark\"] .shadow-lg,\n.dark .shadow-lg {\n  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.3) !important;\n}\n\n[data-theme=\"dark\"] .shadow-xl,\n.dark .shadow-xl {\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.3) !important;\n}\n\n/* ============================================\n   FOCUS STATES (Accessibility)\n   ============================================ */\n\n*:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n  border-radius: var(--radius-md);\n}\n\nbutton:focus-visible,\na:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n}\n\ninput:focus-visible,\ntextarea:focus-visible,\nselect:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 0;\n  border-color: var(--color-border-focus);\n}\n\n/* Remove default focus outline, replaced with our own */\n*:focus {\n  outline: none;\n}\n\n*:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n}\n\n/* ============================================\n   COMPONENT-SPECIFIC STYLES\n   ============================================ */\n\n/* Cards */\n.card {\n  background-color: var(--color-bg-secondary);\n  border: 1px solid var(--color-border-primary);\n  border-radius: var(--radius-xl);\n  padding: var(--spacing-lg);\n  box-shadow: var(--shadow-md);\n  transition: box-shadow var(--transition-base);\n}\n\n.card:hover {\n  box-shadow: var(--shadow-lg);\n}\n\n/* Buttons - Basic Styles (Enhanced in Button component) */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  font-weight: var(--font-weight-medium);\n  border-radius: var(--radius-lg);\n  transition: all var(--transition-base);\n  cursor: pointer;\n  border: none;\n}\n\n.btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Input Fields */\n.input {\n  width: 100%;\n  height: 44px; /* Touch-friendly minimum */\n  padding: 12px 16px;\n  font-size: var(--font-size-base);\n  line-height: var(--line-height-normal);\n  color: var(--color-text-primary);\n  background-color: var(--color-bg-secondary); /* White background */\n  border: 1px solid var(--color-border-primary);\n  border-radius: var(--radius-lg);\n  transition: all var(--transition-base);\n}\n\n.input:hover {\n  border-color: var(--color-border-secondary);\n}\n\n.input:focus {\n  border-color: var(--color-border-focus); /* Green focus */\n  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1); /* Green glow */\n}\n\n.input::placeholder {\n  color: var(--color-text-placeholder);\n}\n\n/* Labels */\n.label {\n  display: block;\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-secondary);\n  margin-bottom: 0.5rem;\n}\n\n.label-required::after {\n  content: ' *';\n  color: var(--color-error);\n}\n\n/* Helper Text */\n.helper-text {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  margin-top: 0.25rem;\n}\n\n.helper-text-error {\n  color: var(--color-error);\n}\n\n/* ============================================\n   UTILITY CLASSES\n   ============================================ */\n\n/* Spacing Utilities */\n.mt-page { margin-top: var(--spacing-2xl); }\n.mb-page { margin-bottom: var(--spacing-2xl); }\n.mt-section { margin-top: var(--spacing-xl); }\n.mb-section { margin-bottom: var(--spacing-xl); }\n\n/* Semantic Backgrounds */\n.bg-success-subtle {\n  background-color: var(--color-success-bg); /* green-50 */\n  color: var(--color-success-dark);\n  border: 1px solid var(--color-success-light);\n}\n\n.bg-error-subtle {\n  background-color: var(--color-error-bg); /* red-50 */\n  color: var(--color-error-dark);\n  border: 1px solid var(--color-error-light);\n}\n\n.bg-warning-subtle {\n  background-color: var(--color-warning-bg); /* amber-50 */\n  color: var(--color-warning-dark);\n  border: 1px solid var(--color-warning-light);\n}\n\n.bg-info-subtle {\n  background-color: var(--color-info-bg); /* blue-50 */\n  color: var(--color-info-dark);\n  border: 1px solid var(--color-info-light);\n}\n\n/* Loading Spinner */\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.animate-spin {\n  animation: spin 1s linear infinite;\n}\n\n/* Fade In Animation */\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.animate-fade-in {\n  animation: fadeIn 0.3s ease-out;\n}\n\n/* ============================================\n   RESPONSIVE DESIGN\n   ============================================ */\n\n/* Mobile-first adjustments */\n@media (max-width: 640px) {\n  .page-title {\n    font-size: var(--font-size-3xl); /* 30px on mobile */\n  }\n  \n  .page-subtitle {\n    font-size: var(--font-size-base); /* 16px on mobile */\n  }\n  \n  h1, .text-4xl {\n    font-size: var(--font-size-3xl);\n  }\n  \n  h2, .text-3xl {\n    font-size: var(--font-size-2xl);\n  }\n}\n\n/* ============================================\n   PRINT STYLES\n   ============================================ */\n\n@media print {\n  body {\n    background-color: white;\n    color: black;\n  }\n  \n  .no-print {\n    display: none !important;\n  }\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * Enhanced Responsive Design System\n * Mobile-first approach with progressive enhancement\n */\n\n/* Base mobile styles (xs: 0px+) */\n.responsive-container {\n  width: 100%;\n  padding-left: 1rem;\n  padding-right: 1rem;\n  margin-left: auto;\n  margin-right: auto;\n}\n\n/* Touch targets - minimum 44px for accessibility */\n.touch-target {\n  min-height: 44px;\n  min-width: 44px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Mobile-first grid system */\n.grid {\n  display: grid;\n  gap: 1rem;\n  grid-template-columns: 1fr;\n}\n\n/* Small devices (sm: 640px+) */\n@media (min-width: 640px) {\n  .responsive-container {\n    max-width: 640px;\n    padding-left: 1.5rem;\n    padding-right: 1.5rem;\n  }\n  \n  .grid-sm-2 {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  \n  .grid-sm-3 {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n/* Medium devices (md: 768px+) */\n@media (min-width: 768px) {\n  .responsive-container {\n    max-width: 768px;\n    padding-left: 2rem;\n    padding-right: 2rem;\n  }\n  \n  .grid-md-2 {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  \n  .grid-md-3 {\n    grid-template-columns: repeat(3, 1fr);\n  }\n  \n  .grid-md-4 {\n    grid-template-columns: repeat(4, 1fr);\n  }\n  \n  /* Tablet-specific layouts */\n  .tablet-layout {\n    display: grid;\n    grid-template-columns: 250px 1fr;\n    gap: 2rem;\n  }\n}\n\n/* Large devices (lg: 1024px+) */\n@media (min-width: 1024px) {\n  .responsive-container {\n    max-width: 1024px;\n  }\n  \n  .grid-lg-2 {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  \n  .grid-lg-3 {\n    grid-template-columns: repeat(3, 1fr);\n  }\n  \n  .grid-lg-4 {\n    grid-template-columns: repeat(4, 1fr);\n  }\n  \n  .grid-lg-6 {\n    grid-template-columns: repeat(6, 1fr);\n  }\n  \n  /* Desktop sidebar layout */\n  .desktop-layout {\n    display: grid;\n    grid-template-columns: 280px 1fr;\n    gap: 2rem;\n  }\n}\n\n/* Extra large devices (xl: 1280px+) */\n@media (min-width: 1280px) {\n  .responsive-container {\n    max-width: 1280px;\n  }\n  \n  .grid-xl-5 {\n    grid-template-columns: repeat(5, 1fr);\n  }\n  \n  .grid-xl-6 {\n    grid-template-columns: repeat(6, 1fr);\n  }\n}\n\n/* 2X Large devices (2xl: 1536px+) */\n@media (min-width: 1536px) {\n  .responsive-container {\n    max-width: 1536px;\n  }\n}\n\n/* Theme density variations */\n.compact {\n  --spacing-unit: 0.25rem;\n  --component-padding: 0.5rem;\n  --component-margin: 0.25rem;\n  --text-size-multiplier: 0.9;\n}\n\n.comfortable {\n  --spacing-unit: 0.5rem;\n  --component-padding: 1rem;\n  --component-margin: 0.5rem;\n  --text-size-multiplier: 1;\n}\n\n.spacious {\n  --spacing-unit: 0.75rem;\n  --component-padding: 1.5rem;\n  --component-margin: 0.75rem;\n  --text-size-multiplier: 1.1;\n}\n\n/* High contrast theme support */\n.high-contrast {\n  --color-background: #ffffff;\n  --color-foreground: #000000;\n  --color-border: #000000;\n  --color-primary: #0000ff;\n  --color-secondary: #666666;\n  --color-success: #008000;\n  --color-warning: #ff8c00;\n  --color-error: #ff0000;\n  --color-info: #0000ff;\n}\n\n.high-contrast-dark {\n  --color-background: #000000;\n  --color-foreground: #ffffff;\n  --color-border: #ffffff;\n  --color-primary: #00ffff;\n  --color-secondary: #cccccc;\n  --color-success: #00ff00;\n  --color-warning: #ffff00;\n  --color-error: #ff0000;\n  --color-info: #00ffff;\n}\n\n/* Layout manager specific styles */\n.layout-manager {\n  position: relative;\n  width: 100%;\n}\n\n.layout-item {\n  position: absolute;\n  cursor: move;\n  -webkit-user-select: none;\n  user-select: none;\n}\n\n.layout-item.dragging {\n  opacity: 0.8;\n  transform: rotate(2deg);\n  z-index: 1000;\n}\n\n.layout-item-content {\n  width: 100%;\n  height: 100%;\n  position: relative;\n  overflow: hidden;\n}\n\n.drop-zone {\n  pointer-events: none;\n  border-radius: 0.5rem;\n}\n\n.resize-handle {\n  position: absolute;\n  bottom: 0;\n  right: 0;\n  width: 1rem;\n  height: 1rem;\n  cursor: se-resize;\n  background: linear-gradient(-45deg, transparent 30%, currentColor 30%, currentColor 40%, transparent 40%);\n}\n\n/* Accessibility improvements */\n@media (prefers-reduced-motion: reduce) {\n  .layout-item {\n    transition: none !important;\n  }\n  \n  .layout-item.dragging {\n    transform: none;\n  }\n}\n\n/* Focus management for keyboard navigation */\n.layout-item:focus {\n  outline: 2px solid var(--color-primary);\n  outline-offset: 2px;\n}\n\n/* Mobile-specific touch improvements */\n@media (hover: none) and (pointer: coarse) {\n  .layout-item {\n    cursor: default;\n  }\n  \n  .touch-target {\n    min-height: 48px;\n    min-width: 48px;\n  }\n  \n  /* Larger touch targets on mobile */\n  .resize-handle {\n    width: 1.5rem;\n    height: 1.5rem;\n  }\n}\n\n/* Print styles */\n@media print {\n  .layout-manager {\n    position: static;\n  }\n  \n  .layout-item {\n    position: static;\n    page-break-inside: avoid;\n    margin-bottom: 1rem;\n  }\n  \n  .resize-handle,\n  .drop-zone {\n    display: none;\n  }\n}\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/* client/src/styles/transitions.css */\n\n/* Page transition animations */\n.page-transitioning {\n  overflow-x: hidden;\n}\n\n.page-enter {\n  opacity: 0;\n  transform: translateY(20px);\n}\n\n.page-enter-active {\n  opacity: 1;\n  transform: translateY(0);\n  transition: opacity 300ms ease-out, transform 300ms ease-out;\n}\n\n.page-exit {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.page-exit-active {\n  opacity: 0;\n  transform: translateY(-20px);\n  transition: opacity 300ms ease-in, transform 300ms ease-in;\n}\n\n/* Smooth scroll behavior */\nhtml {\n  scroll-behavior: smooth;\n}\n\n/* Navigation link transitions */\n.navlink {\n  transition: all 0.2s ease-in-out;\n}\n\n.navlink:hover {\n  transform: translateX(4px);\n}\n\n/* Form transitions */\n.form-fade-in {\n  animation: fadeIn 0.3s ease-out;\n}\n\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* Card slide-in animation */\n.card-slide-in {\n  animation: slideInUp 0.4s ease-out;\n}\n\n@keyframes slideInUp {\n  from {\n    opacity: 0;\n    transform: translateY(30px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* QR code display animation */\n.qr-display {\n  animation: qrDisplayFadeIn 0.5s ease-out;\n}\n\n@keyframes qrDisplayFadeIn {\n  from {\n    opacity: 0;\n    transform: scale(0.9);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n/* Button interaction animations */\n.btn-animate {\n  transition: all 0.2s ease-in-out;\n}\n\n.btn-animate:active {\n  transform: scale(0.98);\n}\n\n/* Loading state animations */\n.loading-pulse {\n  animation: pulse 1.5s ease-in-out infinite;\n}\n\n@keyframes pulse {\n  0%, 100% {\n    opacity: 1;\n  }\n  50% {\n    opacity: 0.6;\n  }\n}\n\n/* Success animations */\n.success-bounce {\n  animation: successBounce 0.6s ease-out;\n}\n\n@keyframes successBounce {\n  0%, 20%, 60%, 100% {\n    transform: translateY(0);\n  }\n  40% {\n    transform: translateY(-10px);\n  }\n  80% {\n    transform: translateY(-5px);\n  }\n}\n\n/* Error shake animation */\n.error-shake {\n  animation: shake 0.5s ease-in-out;\n}\n\n@keyframes shake {\n  0%, 100% {\n    transform: translateX(0);\n  }\n  10%, 30%, 50%, 70%, 90% {\n    transform: translateX(-5px);\n  }\n  20%, 40%, 60%, 80% {\n    transform: translateX(5px);\n  }\n}\n\n/* Mobile-specific transitions */\n@media (max-width: 640px) {\n  .page-enter {\n    transform: translateX(100%);\n  }\n  \n  .page-enter-active {\n    transform: translateX(0);\n  }\n  \n  .page-exit {\n    transform: translateX(0);\n  }\n  \n  .page-exit-active {\n    transform: translateX(-100%);\n  }\n}\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"*, ::before, ::after {\n  --tw-border-spacing-x: 0;\n  --tw-border-spacing-y: 0;\n  --tw-translate-x: 0;\n  --tw-translate-y: 0;\n  --tw-rotate: 0;\n  --tw-skew-x: 0;\n  --tw-skew-y: 0;\n  --tw-scale-x: 1;\n  --tw-scale-y: 1;\n  --tw-pan-x:  ;\n  --tw-pan-y:  ;\n  --tw-pinch-zoom:  ;\n  --tw-scroll-snap-strictness: proximity;\n  --tw-gradient-from-position:  ;\n  --tw-gradient-via-position:  ;\n  --tw-gradient-to-position:  ;\n  --tw-ordinal:  ;\n  --tw-slashed-zero:  ;\n  --tw-numeric-figure:  ;\n  --tw-numeric-spacing:  ;\n  --tw-numeric-fraction:  ;\n  --tw-ring-inset:  ;\n  --tw-ring-offset-width: 0px;\n  --tw-ring-offset-color: #fff;\n  --tw-ring-color: rgb(59 130 246 / 0.5);\n  --tw-ring-offset-shadow: 0 0 #0000;\n  --tw-ring-shadow: 0 0 #0000;\n  --tw-shadow: 0 0 #0000;\n  --tw-shadow-colored: 0 0 #0000;\n  --tw-blur:  ;\n  --tw-brightness:  ;\n  --tw-contrast:  ;\n  --tw-grayscale:  ;\n  --tw-hue-rotate:  ;\n  --tw-invert:  ;\n  --tw-saturate:  ;\n  --tw-sepia:  ;\n  --tw-drop-shadow:  ;\n  --tw-backdrop-blur:  ;\n  --tw-backdrop-brightness:  ;\n  --tw-backdrop-contrast:  ;\n  --tw-backdrop-grayscale:  ;\n  --tw-backdrop-hue-rotate:  ;\n  --tw-backdrop-invert:  ;\n  --tw-backdrop-opacity:  ;\n  --tw-backdrop-saturate:  ;\n  --tw-backdrop-sepia:  ;\n  --tw-contain-size:  ;\n  --tw-contain-layout:  ;\n  --tw-contain-paint:  ;\n  --tw-contain-style:  ;\n}\n\n::backdrop {\n  --tw-border-spacing-x: 0;\n  --tw-border-spacing-y: 0;\n  --tw-translate-x: 0;\n  --tw-translate-y: 0;\n  --tw-rotate: 0;\n  --tw-skew-x: 0;\n  --tw-skew-y: 0;\n  --tw-scale-x: 1;\n  --tw-scale-y: 1;\n  --tw-pan-x:  ;\n  --tw-pan-y:  ;\n  --tw-pinch-zoom:  ;\n  --tw-scroll-snap-strictness: proximity;\n  --tw-gradient-from-position:  ;\n  --tw-gradient-via-position:  ;\n  --tw-gradient-to-position:  ;\n  --tw-ordinal:  ;\n  --tw-slashed-zero:  ;\n  --tw-numeric-figure:  ;\n  --tw-numeric-spacing:  ;\n  --tw-numeric-fraction:  ;\n  --tw-ring-inset:  ;\n  --tw-ring-offset-width: 0px;\n  --tw-ring-offset-color: #fff;\n  --tw-ring-color: rgb(59 130 246 / 0.5);\n  --tw-ring-offset-shadow: 0 0 #0000;\n  --tw-ring-shadow: 0 0 #0000;\n  --tw-shadow: 0 0 #0000;\n  --tw-shadow-colored: 0 0 #0000;\n  --tw-blur:  ;\n  --tw-brightness:  ;\n  --tw-contrast:  ;\n  --tw-grayscale:  ;\n  --tw-hue-rotate:  ;\n  --tw-invert:  ;\n  --tw-saturate:  ;\n  --tw-sepia:  ;\n  --tw-drop-shadow:  ;\n  --tw-backdrop-blur:  ;\n  --tw-backdrop-brightness:  ;\n  --tw-backdrop-contrast:  ;\n  --tw-backdrop-grayscale:  ;\n  --tw-backdrop-hue-rotate:  ;\n  --tw-backdrop-invert:  ;\n  --tw-backdrop-opacity:  ;\n  --tw-backdrop-saturate:  ;\n  --tw-backdrop-sepia:  ;\n  --tw-contain-size:  ;\n  --tw-contain-layout:  ;\n  --tw-contain-paint:  ;\n  --tw-contain-style:  ;\n}/*\n! tailwindcss v3.4.17 | MIT License | https://tailwindcss.com\n*//*\n1. Prevent padding and border from affecting element width. (https://github.com/mozdevs/cssremedy/issues/4)\n2. Allow adding a border to an element by just adding a border-width. (https://github.com/tailwindcss/tailwindcss/pull/116)\n*/\n\n*,\n::before,\n::after {\n  box-sizing: border-box; /* 1 */\n  border-width: 0; /* 2 */\n  border-style: solid; /* 2 */\n  border-color: #e5e7eb; /* 2 */\n}\n\n::before,\n::after {\n  --tw-content: '';\n}\n\n/*\n1. Use a consistent sensible line-height in all browsers.\n2. Prevent adjustments of font size after orientation changes in iOS.\n3. Use a more readable tab size.\n4. Use the user's configured `sans` font-family by default.\n5. Use the user's configured `sans` font-feature-settings by default.\n6. Use the user's configured `sans` font-variation-settings by default.\n7. Disable tap highlights on iOS\n*/\n\nhtml,\n:host {\n  line-height: 1.5; /* 1 */\n  -webkit-text-size-adjust: 100%; /* 2 */ /* 3 */\n  tab-size: 4; /* 3 */\n  font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; /* 4 */\n  font-feature-settings: normal; /* 5 */\n  font-variation-settings: normal; /* 6 */\n  -webkit-tap-highlight-color: transparent; /* 7 */\n}\n\n/*\n1. Remove the margin in all browsers.\n2. Inherit line-height from `html` so users can set them as a class directly on the `html` element.\n*/\n\nbody {\n  margin: 0; /* 1 */\n  line-height: inherit; /* 2 */\n}\n\n/*\n1. Add the correct height in Firefox.\n2. Correct the inheritance of border color in Firefox. (https://bugzilla.mozilla.org/show_bug.cgi?id=190655)\n3. Ensure horizontal rules are visible by default.\n*/\n\nhr {\n  height: 0; /* 1 */\n  color: inherit; /* 2 */\n  border-top-width: 1px; /* 3 */\n}\n\n/*\nAdd the correct text decoration in Chrome, Edge, and Safari.\n*/\n\nabbr:where([title]) {\n  text-decoration: underline dotted;\n}\n\n/*\nRemove the default font size and weight for headings.\n*/\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6 {\n  font-size: inherit;\n  font-weight: inherit;\n}\n\n/*\nReset links to optimize for opt-in styling instead of opt-out.\n*/\n\na {\n  color: inherit;\n  text-decoration: inherit;\n}\n\n/*\nAdd the correct font weight in Edge and Safari.\n*/\n\nb,\nstrong {\n  font-weight: bolder;\n}\n\n/*\n1. Use the user's configured `mono` font-family by default.\n2. Use the user's configured `mono` font-feature-settings by default.\n3. Use the user's configured `mono` font-variation-settings by default.\n4. Correct the odd `em` font sizing in all browsers.\n*/\n\ncode,\nkbd,\nsamp,\npre {\n  font-family: \"Fira Code\", \"JetBrains Mono\", \"SF Mono\", Consolas, monospace; /* 1 */\n  font-feature-settings: normal; /* 2 */\n  font-variation-settings: normal; /* 3 */\n  font-size: 1em; /* 4 */\n}\n\n/*\nAdd the correct font size in all browsers.\n*/\n\nsmall {\n  font-size: 80%;\n}\n\n/*\nPrevent `sub` and `sup` elements from affecting the line height in all browsers.\n*/\n\nsub,\nsup {\n  font-size: 75%;\n  line-height: 0;\n  position: relative;\n  vertical-align: baseline;\n}\n\nsub {\n  bottom: -0.25em;\n}\n\nsup {\n  top: -0.5em;\n}\n\n/*\n1. Remove text indentation from table contents in Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=999088, https://bugs.webkit.org/show_bug.cgi?id=201297)\n2. Correct table border color inheritance in all Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=935729, https://bugs.webkit.org/show_bug.cgi?id=195016)\n3. Remove gaps between table borders by default.\n*/\n\ntable {\n  text-indent: 0; /* 1 */\n  border-color: inherit; /* 2 */\n  border-collapse: collapse; /* 3 */\n}\n\n/*\n1. Change the font styles in all browsers.\n2. Remove the margin in Firefox and Safari.\n3. Remove default padding in all browsers.\n*/\n\nbutton,\ninput,\noptgroup,\nselect,\ntextarea {\n  font-family: inherit; /* 1 */\n  font-feature-settings: inherit; /* 1 */\n  font-variation-settings: inherit; /* 1 */\n  font-size: 100%; /* 1 */\n  font-weight: inherit; /* 1 */\n  line-height: inherit; /* 1 */\n  letter-spacing: inherit; /* 1 */\n  color: inherit; /* 1 */\n  margin: 0; /* 2 */\n  padding: 0; /* 3 */\n}\n\n/*\nRemove the inheritance of text transform in Edge and Firefox.\n*/\n\nbutton,\nselect {\n  text-transform: none;\n}\n\n/*\n1. Correct the inability to style clickable types in iOS and Safari.\n2. Remove default button styles.\n*/\n\nbutton,\ninput:where([type='button']),\ninput:where([type='reset']),\ninput:where([type='submit']) {\n  -webkit-appearance: button; /* 1 */\n  background-color: transparent; /* 2 */\n  background-image: none; /* 2 */\n}\n\n/*\nUse the modern Firefox focus style for all focusable elements.\n*/\n\n:-moz-focusring {\n  outline: auto;\n}\n\n/*\nRemove the additional `:invalid` styles in Firefox. (https://github.com/mozilla/gecko-dev/blob/2f9eacd9d3d995c937b4251a5557d95d494c9be1/layout/style/res/forms.css#L728-L737)\n*/\n\n:-moz-ui-invalid {\n  box-shadow: none;\n}\n\n/*\nAdd the correct vertical alignment in Chrome and Firefox.\n*/\n\nprogress {\n  vertical-align: baseline;\n}\n\n/*\nCorrect the cursor style of increment and decrement buttons in Safari.\n*/\n\n::-webkit-inner-spin-button,\n::-webkit-outer-spin-button {\n  height: auto;\n}\n\n/*\n1. Correct the odd appearance in Chrome and Safari.\n2. Correct the outline style in Safari.\n*/\n\n[type='search'] {\n  -webkit-appearance: textfield; /* 1 */\n  outline-offset: -2px; /* 2 */\n}\n\n/*\nRemove the inner padding in Chrome and Safari on macOS.\n*/\n\n::-webkit-search-decoration {\n  -webkit-appearance: none;\n}\n\n/*\n1. Correct the inability to style clickable types in iOS and Safari.\n2. Change font properties to `inherit` in Safari.\n*/\n\n::-webkit-file-upload-button {\n  -webkit-appearance: button; /* 1 */\n  font: inherit; /* 2 */\n}\n\n/*\nAdd the correct display in Chrome and Safari.\n*/\n\nsummary {\n  display: list-item;\n}\n\n/*\nRemoves the default spacing and border for appropriate elements.\n*/\n\nblockquote,\ndl,\ndd,\nh1,\nh2,\nh3,\nh4,\nh5,\nh6,\nhr,\nfigure,\np,\npre {\n  margin: 0;\n}\n\nfieldset {\n  margin: 0;\n  padding: 0;\n}\n\nlegend {\n  padding: 0;\n}\n\nol,\nul,\nmenu {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n/*\nReset default styling for dialogs.\n*/\ndialog {\n  padding: 0;\n}\n\n/*\nPrevent resizing textareas horizontally by default.\n*/\n\ntextarea {\n  resize: vertical;\n}\n\n/*\n1. Reset the default placeholder opacity in Firefox. (https://github.com/tailwindlabs/tailwindcss/issues/3300)\n2. Set the default placeholder color to the user's configured gray 400 color.\n*/\n\ninput::placeholder,\ntextarea::placeholder {\n  opac
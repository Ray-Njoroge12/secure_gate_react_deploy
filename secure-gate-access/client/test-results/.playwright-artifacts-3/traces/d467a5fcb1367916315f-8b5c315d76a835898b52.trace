lp a {\n  color: #e67e22;\n  text-decoration: none;\n  font-weight: 500;\n}\n\n.network-error-boundary__help a:hover {\n  text-decoration: underline;\n}\n\n/* Responsive design */\n@media (max-width: 768px) {\n  .network-error-boundary {\n    padding: 20px 16px;\n  }\n  \n  .network-error-boundary__title {\n    font-size: 1.25rem;\n  }\n  \n  .network-error-boundary__message {\n    font-size: 0.9rem;\n  }\n  \n  .network-error-boundary__actions {\n    flex-direction: column;\n    align-items: center;\n  }\n  \n  .network-error-boundary__button {\n    width: 100%;\n    max-width: 200px;\n  }\n}\n\n@media (max-width: 480px) {\n  .network-error-boundary {\n    padding: 16px 12px;\n  }\n  \n  .network-error-boundary__icon {\n    font-size: 2.5rem;\n  }\n  \n  .network-error-boundary__title {\n    font-size: 1.1rem;\n  }\n}\n\n/* Dark mode support */\n@media (prefers-color-scheme: dark) {\n  .network-error-boundary {\n    background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);\n    border-color: #f39c12;\n  }\n  \n  .network-error-boundary__title {\n    color: #f39c12;\n  }\n  \n  .network-error-boundary__message {\n    color: #bdc3c7;\n  }\n  \n  .network-error-boundary__suggestions {\n    background: rgba(52, 73, 94, 0.7);\n  }\n  \n  .network-error-boundary__suggestions h4 {\n    color: #f39c12;\n  }\n  \n  .network-error-boundary__suggestions ul {\n    color: #bdc3c7;\n  }\n  \n  .network-error-boundary__help {\n    color: #bdc3c7;\n  }\n  \n  .network-error-boundary__help a {\n    color: #f39c12;\n  }\n}\n\n/* Class-based Dark Mode */\nhtml.dark .network-error-boundary {\n  background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);\n  border-color: #f39c12;\n}\n\nhtml.dark .network-error-boundary__title { color: #f39c12; }\nhtml.dark .network-error-boundary__message { color: #bdc3c7; }\n\nhtml.dark .network-error-boundary__suggestions {\n  background: rgba(52, 73, 94, 0.7);\n}\n\nhtml.dark .network-error-boundary__suggestions h4 { color: #f39c12; }\nhtml.dark .network-error-boundary__suggestions ul { color: #bdc3c7; }\n\nhtml.dark .network-error-boundary__retry-info {\n  background: #5c4a1a;\n  border-color: #f39c12;\n  color: #fcd34d;\n}\n\nhtml.dark .network-error-boundary__help { color: #bdc3c7; }\nhtml.dark .network-error-boundary__help a { color: #f39c12; }\n\n\n\n\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * DESIGN SYSTEM - SecureGate Access Control\n * Comprehensive design tokens for typography, colors, spacing, and components\n * \n * Created: November 14, 2025\n * Last Updated: November 14, 2025\n */\n\n/* ============================================\n   CSS CUSTOM PROPERTIES (Design Tokens)\n   ============================================ */\n\n:root {\n  /* ========== TYPOGRAPHY ========== */\n  \n  /* Font Sizes - Improved Scale */\n  --font-size-xs: 0.75rem;      /* 12px */\n  --font-size-sm: 0.875rem;     /* 14px */\n  --font-size-base: 1rem;       /* 16px */\n  --font-size-lg: 1.125rem;     /* 18px */\n  --font-size-xl: 1.25rem;      /* 20px */\n  --font-size-2xl: 1.5rem;      /* 24px */\n  --font-size-3xl: 1.875rem;    /* 30px */\n  --font-size-4xl: 2.25rem;     /* 36px - was too small before */\n  --font-size-5xl: 3rem;        /* 48px */\n  \n  /* Font Weights */\n  --font-weight-normal: 400;\n  --font-weight-medium: 500;\n  --font-weight-semibold: 600;\n  --font-weight-bold: 700;\n  \n  /* Line Heights - Improved for Readability */\n  --line-height-tight: 1.25;\n  --line-height-snug: 1.375;\n  --line-height-normal: 1.5;\n  --line-height-relaxed: 1.625;  /* Improved from 1.4 */\n  --line-height-loose: 2;\n  \n  /* Letter Spacing */\n  --letter-spacing-tight: -0.025em;\n  --letter-spacing-normal: 0;\n  --letter-spacing-wide: 0.025em;\n  \n  /* ========== COLORS - UNIFIED LIGHT THEME - WCAG AA Compliant ========== */\n  \n  /* Background Colors - Light Theme */\n  --color-bg-primary: #F9FAFB;      /* gray-50 - Main app background */\n  --color-bg-secondary: #FFFFFF;    /* white - Cards, panels */\n  --color-bg-tertiary: #F3F4F6;     /* gray-100 - Elevated surfaces */\n  --color-bg-hover: #F3F4F6;        /* gray-100 - Hover states */\n  --color-bg-subtle: #F9FAFB;       /* gray-50 - Subtle sections */\n  \n  /* Text Colors - WCAG AA Compliant for Light Backgrounds */\n  --color-text-primary: #111827;    /* gray-900 - 16:1 contrast ✅ */\n  --color-text-secondary: #4B5563;  /* gray-600 - 7:1 contrast ✅ */\n  --color-text-tertiary: #6B7280;   /* gray-500 - 4.5:1 contrast ✅ */\n  --color-text-muted: #6B7280;      /* gray-500 - 4.5:1 contrast ✅ (upgraded from gray-400) */\n  --color-text-disabled: #9CA3AF;   /* gray-400 - 3:1 for large text / non-text ✅ (upgraded from gray-300) */\n  --color-text-placeholder: #6B7280; /* gray-500 - 4.5:1 contrast ✅ for input placeholders */\n  \n  /* Border Colors */\n  --color-border-primary: #E5E7EB;   /* gray-200 - Default borders */\n  --color-border-secondary: #D1D5DB; /* gray-300 - Strong borders */\n  --color-border-focus: #10B981;     /* green-500 - Focus state */\n  \n  /* Semantic Colors - Success, Error, Warning, Info */\n  --color-success: #10B981;          /* green-500 */\n  --color-success-light: #D1FAE5;    /* green-100 - Light backgrounds */\n  --color-success-dark: #059669;     /* green-600 - Hover */\n  --color-success-bg: #ECFDF5;       /* green-50 - Subtle backgrounds */\n  \n  --color-error: #EF4444;            /* red-500 */\n  --color-error-light: #FEE2E2;      /* red-100 - Light backgrounds */\n  --color-error-dark: #DC2626;       /* red-600 - Hover */\n  --color-error-bg: #FEF2F2;         /* red-50 - Subtle backgrounds */\n  \n  --color-warning: #F59E0B;          /* amber-500 */\n  --color-warning-light: #FEF3C7;    /* amber-100 - Light backgrounds */\n  --color-warning-dark: #D97706;     /* amber-600 - Hover */\n  --color-warning-bg: #FFFBEB;       /* amber-50 - Subtle backgrounds */\n  \n  --color-info: #3B82F6;             /* blue-500 */\n  --color-info-light: #DBEAFE;       /* blue-100 - Light backgrounds */\n  --color-info-dark: #2563EB;        /* blue-600 - Hover */\n  --color-info-bg: #EFF6FF;          /* blue-50 - Subtle backgrounds */\n  \n  /* Brand Colors - Green Theme */\n  --color-brand-primary: #10B981;    /* green-500 - Primary actions */\n  --color-brand-primary-hover: #059669; /* green-600 - Hover state */\n  --color-brand-secondary: #3B82F6;  /* blue-500 - Secondary actions */\n  \n  /* ========== SPACING ========== */\n  --spacing-xs: 0.25rem;    /* 4px */\n  --spacing-sm: 0.5rem;     /* 8px */\n  --spacing-md: 1rem;       /* 16px */\n  --spacing-lg: 1.5rem;     /* 24px */\n  --spacing-xl: 2rem;       /* 32px */\n  --spacing-2xl: 3rem;      /* 48px */\n  --spacing-3xl: 4rem;      /* 64px */\n  \n  /* ========== BORDER RADIUS ========== */\n  --radius-sm: 0.25rem;     /* 4px */\n  --radius-md: 0.375rem;    /* 6px */\n  --radius-lg: 0.5rem;      /* 8px */\n  --radius-xl: 0.75rem;     /* 12px */\n  --radius-2xl: 1rem;       /* 16px */\n  --radius-full: 9999px;    /* Fully rounded */\n  \n  /* ========== SHADOWS ========== */\n  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);\n  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n  \n  /* ========== TRANSITIONS ========== */\n  --transition-fast: 150ms ease-in-out;\n  --transition-base: 200ms ease-in-out;\n  --transition-slow: 300ms ease-in-out;\n  \n  /* ========== Z-INDEX SCALE ========== */\n  --z-index-dropdown: 1000;\n  --z-index-sticky: 1020;\n  --z-index-fixed: 1030;\n  --z-index-modal-backdrop: 1040;\n  --z-index-modal: 1050;\n  --z-index-popover: 1060;\n  --z-index-tooltip: 1070;\n}\n\n/* ============================================\n   BASE STYLES\n   ============================================ */\n\nbody {\n  font-size: var(--font-size-base);\n  line-height: var(--line-height-relaxed); /* Improved readability */\n  font-weight: var(--font-weight-normal);\n  color: var(--color-text-primary);\n  background-color: var(--color-bg-primary); /* Light theme: gray-50 */\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n/* Dark Mode Overrides */\n[data-theme=\"dark\"] {\n  --color-bg-primary: #0f172a;      /* slate-900 */\n  --color-bg-secondary: #1e293b;    /* slate-800 */\n  --color-bg-tertiary: #334155;     /* slate-700 */\n  --color-bg-hover: #334155;        /* slate-700 */\n  --color-bg-subtle: #0f172a;       /* slate-900 */\n  \n  --color-text-primary: #f8fafc;    /* slate-50 - 15.4:1 contrast on slate-900 ✅ */\n  --color-text-secondary: #cbd5e1;  /* slate-300 - 9.1:1 contrast ✅ */\n  --color-text-tertiary: #94a3b8;   /* slate-400 - 5.6:1 contrast ✅ */\n  --color-text-muted: #94a3b8;      /* slate-400 - 5.6:1 contrast ✅ (upgraded from slate-500) */\n  --color-text-disabled: #64748b;   /* slate-500 - 3.5:1 for large text ✅ (upgraded from slate-600) */\n  --color-text-placeholder: #94a3b8; /* slate-400 - 5.6:1 contrast ✅ */\n  \n  --color-border-primary: #334155;   /* slate-700 */\n  --color-border-secondary: #475569; /* slate-600 */\n\n  /* Dark mode semantic background tints */\n  --color-success-bg: #064e3b;       /* green-900 */\n  --color-success-light: #065f46;    /* green-800 */\n  --color-error-bg: #7f1d1d;        /* red-900 */\n  --color-error-light: #991b1b;     /* red-800 */\n  --color-warning-bg: #78350f;      /* amber-900 */\n  --color-warning-light: #92400e;   /* amber-800 */\n  --color-info-bg: #1e3a8a;         /* blue-900 */\n  --color-info-light: #1e40af;      /* blue-800 */\n\n  /* Dark mode shadow adjustments */\n  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);\n  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3);\n  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.3);\n  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.3);\n}\n\n/* Button Variants */\n.btn-primary, .btn.primary {\n  background-color: var(--color-brand-primary);\n  color: white;\n}\n.btn-primary:hover, .btn.primary:hover {\n  background-color: var(--color-brand-primary-hover);\n}\n\n.btn-secondary, .btn.secondary {\n  background-color: var(--color-bg-secondary);\n  color: var(--color-text-primary);\n  border: 1px solid var(--color-border-primary);\n}\n.btn-secondary:hover, .btn.secondary:hover {\n  background-color: var(--color-bg-hover);\n}\n\n/* ============================================\n   TYPOGRAPHY STYLES\n   ============================================ */\n\n/* Headings */\nh1, .text-4xl, .page-title {\n  font-size: var(--font-size-4xl);  /* 36px - was ~24px */\n  font-weight: var(--font-weight-bold);\n  line-height: var(--line-height-tight);\n  color: var(--color-text-primary);\n  margin-bottom: 0.5rem;\n  letter-spacing: var(--letter-spacing-tight);\n}\n\nh2, .text-3xl, .section-title {\n  font-size: var(--font-size-3xl);  /* 30px */\n  font-weight: var(--font-weight-semibold);\n  line-height: var(--line-height-snug);\n  color: var(--color-text-primary);\n  margin-bottom: 0.5rem;\n}\n\nh3, .text-2xl, .card-title {\n  font-size: var(--font-size-2xl);  /* 24px */\n  font-weight: var(--font-weight-semibold);\n  line-height: var(--line-height-snug);\n  color: var(--color-text-primary);\n  margin-bottom: 0.5rem;\n}\n\nh4, .text-xl {\n  font-size: var(--font-size-xl);   /* 20px */\n  font-weight: var(--font-weight-semibold);\n  line-height: var(--line-height-normal);\n  color: var(--color-text-primary);\n}\n\nh5, .text-lg {\n  font-size: var(--font-size-lg);   /* 18px */\n  font-weight: var(--font-weight-medium);\n  line-height: var(--line-height-normal);\n  color: var(--color-text-primary);\n}\n\nh6, .text-base {\n  font-size: var(--font-size-base); /* 16px */\n  font-weight: var(--font-weight-medium);\n  line-height: var(--line-height-normal);\n  color: var(--color-text-primary);\n}\n\n/* Body Text Sizes */\n.text-sm {\n  font-size: var(--font-size-sm);   /* 14px */\n  line-height: var(--line-height-normal);\n}\n\n.text-xs {\n  font-size: var(--font-size-xs);   /* 12px */\n  line-height: var(--line-height-normal);\n}\n\n/* Paragraph Styles */\np {\n  margin-bottom: 1rem;\n  line-height: var(--line-height-relaxed);\n}\n\np:last-child {\n  margin-bottom: 0;\n}\n\n/* Page Title Specific */\n.page-title {\n  font-size: var(--font-size-4xl);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--line-height-tight);\n  color: var(--color-text-primary);\n  margin-bottom: 0.5rem;\n}\n\n.page-subtitle {\n  font-size: var(--font-size-lg);   /* 18px - was 16px */\n  font-weight: var(--font-weight-normal);\n  line-height: var(--line-height-relaxed);\n  color: var(--color-text-secondary); /* Improved contrast */\n  margin-bottom: 2rem;\n}\n\n/* ============================================\n   TEXT COLOR UTILITIES (WCAG Compliant)\n   ============================================ */\n\n.text-primary {\n  color: var(--color-text-primary);\n}\n\n.text-secondary {\n  color: var(--color-text-secondary);\n}\n\n.text-muted {\n  color: var(--color-text-muted);\n}\n\n.text-disabled {\n  color: var(--color-text-disabled);\n}\n\n/* Override problematic Tailwind classes */\n.text-slate-400 {\n  color: var(--color-text-secondary) !important; /* Fix contrast */\n}\n\n.text-gray-400 {\n  color: var(--color-text-secondary) !important; /* Fix contrast */\n}\n\n/* Override problematic muted text classes for WCAG AA compliance */\n.text-gray-500 {\n  color: var(--color-text-tertiary) !important; /* 4.5:1 minimum ✅ */\n}\n\n/* ============================================\n   PLACEHOLDER CONTRAST FIX (WCAG AA)\n   ============================================ */\n\n/* Global placeholder text must meet 4.5:1 contrast ratio */\n::placeholder {\n  color: var(--color-text-placeholder) !important;\n  opacity: 1 !important;\n}\n\n::-webkit-input-placeholder {\n  color: var(--color-text-placeholder) !important;\n  opacity: 1 !important;\n}\n\n::-moz-placeholder {\n  color: var(--color-text-placeholder) !important;\n  opacity: 1 !important;\n}\n\n:-ms-input-placeholder {\n  color: var(--color-text-placeholder) !important;\n  opacity: 1 !important;\n}\n\n/* ============================================\n   DARK MODE UTILITY OVERRIDES (WCAG AA)\n   Ensures Tailwind dark: utilities use compliant colors\n   ============================================ */\n\n/* Fix dark mode text-gray-400 — too low contrast on dark backgrounds */\n[data-theme=\"dark\"] .dark\\:text-gray-400,\n.dark .dark\\:text-gray-400 {\n  color: #cbd5e1 !important; /* slate-300: 9.1:1 ✅ */\n}\n\n/* Fix dark mode text-gray-500 — too low contrast on dark backgrounds */\n[data-theme=\"dark\"] .dark\\:text-gray-500,\n.dark .dark\\:text-gray-500 {\n  color: #94a3b8 !important; /* slate-400: 5.6:1 ✅ */\n}\n\n/* ============================================\n   COMPREHENSIVE DARK MODE SAFETY NET\n   Catches all Tailwind utility classes missing explicit dark: overrides\n   ============================================ */\n\n/* --- Background Color Overrides --- */\n[data-theme=\"dark\"] .bg-white:not([class*=\"dark:bg-\"]),\n.dark .bg-white:not([class*=\"dark:bg-\"]) {\n  background-color: #1e293b !important; /* slate-800 */\n}\n\n[data-theme=\"dark\"] .bg-gray-50:not([class*=\"dark:bg-\"]),\n.dark .bg-gray-50:not([class*=\"dark:bg-\"]) {\n  background-color: #0f172a !important; /* slate-900 */\n}\n\n[data-theme=\"dark\"] .bg-gray-100:not([class*=\"dark:bg-\"]),\n.dark .bg-gray-100:not([class*=\"dark:bg-\"]) {\n  background-color: #1e293b !important; /* slate-800 */\n}\n\n[data-theme=\"dark\"] .bg-gray-200:not([class*=\"dark:bg-\"]),\n.dark .bg-gray-200:not([class*=\"dark:bg-\"]) {\n  background-color: #334155 !important; /* slate-700 */\n}\n\n[data-theme=\"dark\"] .bg-gray-300:not([class*=\"dark:bg-\"]),\n.dark .bg-gray-300:not([class*=\"dark:bg-\"]) {\n  background-color: #475569 !important; /* slate-600 */\n}\n\n[data-theme=\"dark\"] .bg-gray-400:not([class*=\"dark:bg-\"]),\n.dark .bg-gray-400:not([class*=\"dark:bg-\"]) {\n  background-color: #64748b !important; /* slate-500 */\n}\n\n[data-theme=\"dark\"] .bg-gray-500:not([class*=\"dark:bg-\"]),\n.dark .bg-gray-500:not([class*=\"dark:bg-\"]) {\n  background-color: #64748b !important; /* slate-500 */\n}\n\n/* --- Text Color Overrides — WCAG AA Compliant --- */\n[data-theme=\"dark\"] .text-gray-900:not([class*=\"dark:text-\"]),\n.dark .text-gray-900:not([class*=\"dark:text-\"]) {\n  color: #f1f5f9 !important; /* slate-100: 14.5:1 on slate-900 ✅ */\n}\n\n[data-theme=\"dark\"] .text-gray-800:not([class*=\"dark:text-\"]),\n.dark .text-gray-800:not([class*=\"dark:text-\"]) {\n  color: #e2e8f0 !important; /* slate-200: 12.1:1 ✅ */\n}\n\n[data-theme=\"dark\"] .text-gray-700:not([class*=\"dark:text-\"]),\n.dark .text-gray-700:not([class*=\"dark:text-\"]) {\n  color: #cbd5e1 !important; /* slate-300: 9.1:1 ✅ */\n}\n\n[data-theme=\"dark\"] .text-gray-600:not([class*=\"dark:text-\"]),\n.dark .text-gray-600:not([class*=\"dark:text-\"]) {\n  color: #cbd5e1 !important; /* slate-300: 9.1:1 ✅ */\n}\n\n[data-theme=\"dark\"] .text-gray-500:not([class*=\"dark:text-\"]),\n.dark .text-gray-500:not([class*=\"dark:text-\"]) {\n  color: #94a3b8 !important; /* slate-400: 5.6:1 ✅ */\n}\n\n[data-theme=\"dark\"] .text-gray-400:not([class*=\"dark:text-\"]),\n.dark .text-gray-400:not([class*=\"dark:text-\"]) {\n  color: #cbd5e1 !important; /* slate-300: 9.1:1 ✅ */\n}\n\n[data-theme=\"dark\"] .text-gray-300:not([class*=\"dark:text-\"]),\n.dark .text-gray-300:not([class*=\"dark:text-\"]) {\n  color: #e2e8f0 !important; /* slate-200: 12.1:1 ✅ */\n}\n\n[data-theme=\"dark\"] .text-black:not([class*=\"dark:text-\"]),\n.dark .text-black:not([class*=\"dark:text-\"]) {\n  color: #f8fafc !important; /* slate-50 ✅ */\n}\n\n/* --- Border Color Overrides --- */\n[data-theme=\"dark\"] .border-gray-200:not([class*=\"dark:border-\"]),\n.dark .border-gray-200:not([class*=\"dark:border-\"]) {\n  border-color: #334155 !important; /* slate-700 */\n}\n\n[data-theme=\"dark\"] .border-gray-300:not([class*=\"dark:border-\"]),\n.dark .border-gray-300:not([class*=\"dark:border-\"]) {\n  border-color: #475569 !important; /* slate-600 */\n}\n\n[data-theme=\"dark\"] .border-gray-100:not([class*=\"dark:border-\"]),\n.dark .border-gray-100:not([class*=\"dark:border-\"]) {\n  border-color: #334155 !important; /* slate-700 */\n}\n\n[data-theme=\"dark\"] .border-gray-400:not([class*=\"dark:border-\"]),\n.dark .border-gray-400:not([class*=\"dark:border-\"]) {\n  border-color: #64748b !important; /* slate-500 */\n}\n\n/* --- Divide Color Overrides --- */\n[data-theme=\"dark\"] .divide-gray-200:not([class*=\"dark:divide-\"]) > :not([hidden]) ~ :not([hidden]),\n.dark .divide-gray-200:not([class*=\"dark:divide-\"]) > :not([hidden]) ~ :not([hidden]) {\n  border-color: #334155 !important; /* slate-700 */\n}\n\n[data-theme=\"dark\"] .divide-gray-300:not([class*=\"dark:divide-\"]) > :not([hidden]) ~ :not([hidden]),\n.dark .divide-gray-300:not([class*=\"dark:divide-\"]) > :not([hidden]) ~ :not([hidden]) {\n  border-color: #475569 !important; /* slate-600 */\n}\n\n/* --- Ring Color Overrides --- */\n[data-theme=\"dark\"] .ring-gray-300:not([class*=\"dark:ring-\"]),\n.dark .ring-gray-300:not([class*=\"dark:ring-\"]) {\n  --tw-ring-color: #475569 !important; /* slate-600 */\n}\n\n[data-theme=\"dark\"] .ring-gray-200:not([class*=\"dark:ring-\"]),\n.dark .ring-gray-200:not([class*=\"dark:ring-\"]) {\n  --tw-ring-color: #334155 !important; /* slate-700 */\n}\n\n/* --- Hover State Overrides --- */\n[data-theme=\"dark\"] .hover\\:bg-gray-50:not([class*=\"dark:hover:bg-\"]):hover,\n.dark .hover\\:bg-gray-50:not([class*=\"dark:hover:bg-\"]):hover {\n  background-color: #334155 !important; /* slate-700 */\n}\n\n[data-theme=\"dark\"] .hover\\:bg-gray-100:not([class*=\"dark:hover:bg-\"]):hover,\n.dark .hover\\:bg-gray-100:not([class*=\"dark:hover:bg-\"]):hover {\n  background-color: #334155 !important; /* slate-700 */\n}\n\n[data-theme=\"dark\"] .hover\\:bg-gray-200:not([class*=\"dark:hover:bg-\"]):hover,\n.dark .hover\\:bg-gray-200:not([class*=\"dark:hover:bg-\"]):hover {\n  background-color: #475569 !important; /* slate-600 */\n}\n\n[data-theme=\"dark\"] .hover\\:bg-gray-300:not([class*=\"dark:hover:bg-\"]):hover,\n.dark .hover\\:bg-gray-300:not([class*=\"dark:hover:bg-\"]):hover {\n  background-color: #475569 !important; /* slate-600 */\n}\n\n[data-theme=\"dark\"] .hover\\:bg-gray-400:not([class*=\"dark:hover:bg-\"]):hover,\n.dark .hover\\:bg-gray-400:not([class*=\"dark:hover:bg-\"]):hover {\n  background-color: #64748b !important; /* slate-500 */\n}\n\n[data-theme=\"dark\"] .active\\:bg-gray-400:not([class*=\"dark:active:bg-\"]):active,\n.dark .active\\:bg-gray-400:not([class*=\"dark:active:bg-\"]):active {\n  background-color: #64748b !important; /* slate-500 */\n}\n\n[data-theme=\"dark\"] .disabled\\:bg-gray-400:disabled,\n.dark .disabled\\:bg-gray-400:disabled {\n  background-color: #475569 !important; /* slate-600 */\n}\n\n/* --- Placeholder Overrides for Dark Mode --- */\n[data-theme=\"dark\"] input::placeholder,\n[data-theme=\"dark\"] textarea::placeholder,\n.dark input::placeholder,\n.dark textarea::placeholder {\n  color: #94a3b8 !important; /* slate-400: 5.6:1 ✅ */\n}\n\n/* --- Focus Ring Overrides for Dark Mode --- */\n[data-theme=\"dark\"] .focus\\:ring-gray-300:focus,\n.dark .focus\\:ring-gray-300:focus {\n  --tw-ring-color: #475569 !important; /* slate-600 */\n}\n\n[data-theme=\"dark\"] .focus\\:ring-gray-500:focus,\n.dark .focus\\:ring-gray-500:focus {\n  --tw-ring-color: #94a3b8 !important; /* slate-400 */\n}\n\n[data-theme=\"dark\"] .focus\\:border-gray-300:focus,\n.dark .focus\\:border-gray-300:focus {\n  border-color: #475569 !important; /* slate-600 */\n}\n\n/* --- Semantic Light Backgrounds in Dark Mode --- */\n[data-theme=\"dark\"] .bg-blue-50:not([class
# Docker ignore file for Secure Gate Frontend
# Exclude unnecessary files from Docker build context

# Build output (will be built in container)
build/
dist/

# Node modules (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.development
.env.test

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Test files
src/__tests__/
src/**/*.test.js
src/**/*.test.jsx
src/**/*.spec.js
src/**/*.spec.jsx

# Development utilities
src/scripts/
src/utils/accessibilityAudit.js
src/utils/performanceOptimization.js
src/utils/responsiveTestUtils.js

# Backup files
*.backup
*.bak

# Temporary files
tmp/
temp/


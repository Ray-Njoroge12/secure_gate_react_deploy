{
  "name": "secure-gate-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Secure Gate Access Control System - Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --inspect server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "test:health": "jest --testPathPattern=health-monitoring-integration --verbose",
    "health:check": "node -e \"import('./server/integration/health-monitoring-integration.js').then(m => m.validateHealthSetup({}))\"",
    "lint": "eslint server/ --ext .js",
    "lint:fix": "eslint server/ --ext .js --fix"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "redis": "^4.6.7",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.6.2",
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "preset": "node",
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "globals": {
      "__dirname": true
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/tests/**",
      "!**/node_modules/**"
    ]
  },
  "keywords": [
    "security",
    "access-control",
    "authentication",
    "express",
    "nodejs"
  ],
  "author": "Secure Gate Team",
  "license": "MIT"
}

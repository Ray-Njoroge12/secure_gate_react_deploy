{
  "name": "secure-gate-access",
  "version": "1.0.0",
  "description": "Secure Gate Access Control System - Monorepo Root",
  "private": true,
  "scripts": {
    "start": "cd server && npm start",
    "setup": "node scripts/setup-cross-platform.js",
    "verify": "node scripts/verify-cross-platform-setup.js",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "build:client": "cd client && npm run build",
    "validate:csp": "node scripts/validate-csp.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm start",
    "dev:network": "cd client && npm run dev:network",
    "dev:tunnel": "npx cloudflared tunnel --url http://localhost:3000",
    "postinstall": "cd server && npm install",
    "test:parallel": "node tests/parallel-test-runner.mjs",
    "test:puppeteer": "node tests/parallel-test-runner.mjs --puppeteer",
    "test:playwright": "node tests/parallel-test-runner.mjs --playwright",
    "test:puppeteer:ui-ux": "node tests/puppeteer/ui-ux-tests.js",
    "test:all": "node tests/parallel-test-runner.mjs --all"
  },
  "engines": {
    "node": ">=18"
  }
}
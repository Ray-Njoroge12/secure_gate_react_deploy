# =============================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# =============================================================================
# Docker-specific production configuration
# Copy to .env.docker and replace all CHANGEME_ placeholders
# =============================================================================

# Database Password (Docker PostgreSQL container)
POSTGRES_PASSWORD=CHANGEME_STRONG_DATABASE_PASSWORD

# Redis Password (Docker Redis container)
REDIS_PASSWORD=CHANGEME_STRONG_REDIS_PASSWORD

# JWT Secrets (64 bytes minimum)
JWT_SECRET=CHANGEME_GENERATE_64_BYTE_SECRET
JWT_REFRESH_SECRET=CHANGEME_GENERATE_64_BYTE_SECRET

# Session Secret (64 bytes minimum)
SESSION_SECRET=CHANGEME_GENERATE_64_BYTE_SECRET

# Security Flags (Production defaults)
ENFORCE_HTTPS=true
ALLOW_HTTP_IN_PRODUCTION=false
SECURE_COOKIES=true

# =============================================================================
# GENERATE SECRETS COMMAND
# =============================================================================
# docker run --rm node:18-alpine node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"

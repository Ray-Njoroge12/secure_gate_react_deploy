{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentBundle",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::<EB_DEPLOYMENT_BUCKET_NAME>/<APP_BUNDLE_PREFIX>/*"
    },
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "<APP_JWT_SECRET_ARN>",
        "<APP_REFRESH_SECRET_ARN>",
        "<SESSION_SECRET_ARN>",
        "<DATABASE_PASSWORD_SECRET_ARN>",
        "<REDIS_PASSWORD_SECRET_ARN>",
        "<MAILGUN_API_KEY_SECRET_ARN>",
        "<AT_API_KEY_SECRET_ARN>",
        "<ENCRYPTION_KEY_SECRET_ARN>"
      ]
    },
    {
      "Sid": "DecryptSecrets",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "<KMS_KEY_ARN>"
    },
    {
      "Sid": "WriteAppLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:<AWS_REGION>:<AWS_ACCOUNT_ID>:log-group:/aws/elasticbeanstalk/<APP_NAME>/*"
      ]
    },
    {
      "Sid": "ReadAppParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/secure-gate/*"
      ]
    }
  ]
}

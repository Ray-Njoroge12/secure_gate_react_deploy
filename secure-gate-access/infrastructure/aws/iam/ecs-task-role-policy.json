{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "<APP_JWT_SECRET_ARN>",
        "<APP_REFRESH_SECRET_ARN>",
        "<SESSION_SECRET_ARN>",
        "<DATABASE_PASSWORD_SECRET_ARN>",
        "<REDIS_PASSWORD_SECRET_ARN>",
        "<MAILGUN_API_KEY_SECRET_ARN>",
        "<AT_API_KEY_SECRET_ARN>",
        "<ENCRYPTION_KEY_SECRET_ARN>"
      ]
    },
    {
      "Sid": "DecryptSecrets",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "<KMS_KEY_ARN>"
    },
    {
      "Sid": "ReadAppParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/secure-gate/*"
      ]
    },
    {
      "Sid": "UploadsBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::<UPLOADS_BUCKET_NAME>/private/*",
        "arn:aws:s3:::<UPLOADS_BUCKET_NAME>/public/*"
      ]
    },
    {
      "Sid": "UploadsBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::<UPLOADS_BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "private/*",
            "public/*"
          ]
        }
      }
    }
  ]
}

# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Database Configuration
POSTGRES_DB=secure_gate
POSTGRES_USER=secure_gate_user
POSTGRES_PASSWORD=your_secure_database_password_here

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_very_secure_jwt_refresh_secret_key_here_minimum_32_characters
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Application URLs
FRONTEND_URL=https://securegate.com
REACT_APP_API_URL=https://api.securegate.com
REACT_APP_ENVIRONMENT=production
REACT_APP_VERSION=1.0.0

# Email Configuration
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-email@securegate.com
SMTP_PASS=your_email_password_here
SMTP_FROM=noreply@securegate.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
MONITORING_INTERVAL_MS=60000

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoring (Optional)
GRAFANA_PASSWORD=your_grafana_admin_password_here

# SSL Configuration (for Nginx)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Performance
NODE_OPTIONS=--max-old-space-size=1024
WORKER_PROCESSES=auto

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
